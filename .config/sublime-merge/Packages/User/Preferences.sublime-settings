{
    // ==========================================================================
    // DevTools2 Sublime Merge 전역 설정 (Preferences.sublime-settings)
    // ==========================================================================

    // 공식 다크 UI 테마 및 블랙 계열 대표 컬러 스킴(Monokai)
    // (평가판은 UI 테마가 라이트로 고정되며, 그때 diff·커밋 메시지 등 뷰별 색 구성은
    //  "... - Merge.sublime-settings"(라이트, Kanagawa Lotus)가, 다크 테마에서는 "... - Merge Dark.sublime-settings"(Monokai)가 덮어씁니다)
    "theme": "Merge Dark.sublime-theme",
    "dark_theme": "Merge Dark.sublime-theme",
    "light_theme": "Merge Dark.sublime-theme",
    "color_scheme": "Monokai.sublime-color-scheme",
    "dark_color_scheme": "Monokai.sublime-color-scheme",
    "light_color_scheme": "Monokai.sublime-color-scheme",

    // 에디터 폰트 설정 (공식 D2Coding 리거처 폰트 적용 - 한글 겹침 방지)
    "font_face": "D2Coding ligature",
    "font_size": 11.5,

    // 줄 간격 (nvim의 cellHeight 1.5와 유사하게 여유로운 줄 높이 제공)
    "line_padding_top": 3,
    "line_padding_bottom": 3,

    // Diff 뷰어 가독성 옵션
    "diff_algorithm": "myers",
    "draw_white_space": "selection",
    "show_line_endings": false,
    "line_numbers": true,
    "ruler": 100,

    // 탭 및 들여쓰기 (DevTools2 표준 2칸 들여쓰기)
    "tab_size": 2,
    "translate_tabs_to_spaces": true,

    // 파일 변경 감지 및 자동 새로고침
    "always_prompt_for_rebase": false
}
