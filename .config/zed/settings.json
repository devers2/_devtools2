{
  // ==============================================================================
  // 🌟 [Zed 확장 프로그램 자동 설치 및 동기화 설정]
  // - 새로운 확장을 설치 및 동기화하려면 아래 목록에 "확장명": true 를 추가한 뒤 Git에 저장하세요.
  // - "확장명"은 운영체제별로 아래 디렉토리에서 확장명을 확인할 수 있음(설치된 확장 디렉토리명 확인)
  //   [Windows] %LOCALAPPDATA%\Zed\extensions\installed
  //   [Linux] ~/.local/share/zed/extensions/
  //   [WSL] ~/.local/share/zed/remote_extensions/
  //   (예: "kotlin": true, "docker": true)
  // ==============================================================================
  "auto_install_extensions": {
    // [테마 확장]
    "kanagawa-themes": true,

    // [Spring Boot / Gradle 개발 필수]
    "java": true, // Java 언어 지원 (Gradle·properties 파일, Java 디버거 포함)
    "kotlin": true, // Kotlin / build.gradle.kts
    "html": true,
    "xml": true, // Spring XML/pom.xml 설정 지원
    "sql": true, // MyBatis·DB 스크립트(.sql) 구문 강조

    // [Python] — Python 은 Zed 내장 지원(basedpyright + ruff)이라 확장이 필요 없음
    //   (예전 "python": true 는 Zed 확장 목록에 없는 이름이라 아무것도 설치되지 않았음)

    // [Node / Web] — JS·TS·JSON·CSS·Tailwind 는 Zed 내장 지원
    "vue": true, // Vue 단일 파일 컴포넌트(.vue)
    "emmet": true, // div.box>ul>li*3 같은 축약 입력 (Neovim 의 emmet_language_server 와 같은 기능)

    // [기타 프로젝트 지원]
    "toml": true, // tool-versions.toml 등 설정용
    "dockerfile": true, // Dockerfile
    "docker-compose": true, // docker-compose.yml
    "env": true, // .env 파일
    "ini": true, // .ini / .editorconfig 등
    "make": true, // Makefile
    "log": true, // 로그 파일 강조
    "git-firefly": true, // .gitignore · 커밋 메시지 등 Git 파일
    "powershell": true // PowerShell 쉘 스크립트 지원
  },

  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features": {
    "calt": true
  },
  "theme": {
    "mode": "system",
    "light": "Kanagawa Dragon",
    "dark": "Kanagawa Wave"
  },

  // 기본 탭 크기는 2로 유지
  "tab_size": 2,
  // 기존 파일의 2칸 들여쓰기를 자동 감지하여 4칸 설정을 덮어쓰는 것 방지
  "detect_indentation": false,

  "autosave": "on_focus_change",
  "format_on_save": "on",
  "preferred_line_length": 100,
  "soft_wrap": "preferred_line_length",

  "languages": {
    // Java: 탭 크기 4 설정
    "Java": {
      "language_servers": ["jdtls"],
      "tab_size": 4
    },
    // Python: 탭 크기 4 설정 (PEP 8 표준)
    // - 코드 분석: Zed 기본값 basedpyright(+ ruff 진단) — Neovim 과 같은 조합. 가상환경은 프로젝트 설정 스크립트가 만드는
    //   pyrightconfig.json(venvPath/venv)으로 인식
    // - 포맷: Neovim(ruff_fix + ruff_format)과 같게 — 저장 시 ruff 로 자동 수정(fixAll)·import 정리 후 ruff 포맷
    //   (ruff 설정 파일 선택은 아래 lsp.ruff — 프로젝트 설정 우선, 없으면 DevTools2 공통 ruff.toml)
    "Python": {
      "tab_size": 4,
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      },
      "formatter": { "language_server": { "name": "ruff" } }
    },

    // ── [Prettier 포맷 — Neovim 과 같은 설정 선택] ─────────────────────────────────
    // Zed 내장 Prettier 는 프로젝트에 Prettier 설정이 없으면 Prettier 기본값(큰따옴표 등)으로 포맷해서, Neovim
    // (DevTools2 공통 .config/prettier/.prettierrc.cjs 사용)과 결과가 달랐습니다. 래퍼가 "프로젝트 설정 우선, 없으면
    // DevTools2 공통 설정"으로 고르고, 프로젝트에 설치된 Prettier 가 있으면 그것을 씁니다 (scripts/zed/prettier-format 설명).
    // (Neovim 의 formatters_by_ft 에서 prettier 를 쓰는 언어와 같은 목록)
    "JavaScript": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "TypeScript": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "TSX": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "JSON": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "JSONC": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "CSS": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "HTML": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "Vue.js": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "YAML": { "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } } },
    "Markdown": {
      "preferred_line_length": 120, // 마크다운은 가독성을 위해 예외적으로 120
      "soft_wrap": "preferred_line_length",
      "formatter": { "external": { "command": "/var/opt/_devtools2/scripts/zed/prettier-format", "arguments": ["{buffer_path}"] } }
    }
  },

  "lsp": {
    // [ruff — Python 린트·포맷] 설정 파일 선택을 Neovim 과 같게: 프로젝트의 ruff.toml / .ruff.toml / pyproject.toml([tool.ruff])
    // 이 있으면 그것(filesystemFirst), 없으면 DevTools2 공통 ruff.toml
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "/var/opt/_devtools2/.config/ruff/ruff.toml",
          "configurationPreference": "filesystemFirst"
        }
      }
    },
    "jdtls": {
      // ==============================================================================
      // 🌟 [Zed 전용 JDTLS 커스텀 런처 연동]
      // - Zed의 Java 기본 확장이 인터넷에서 JDTLS를 다운로드하는 기본 동작 대신,
      //   아래 전용 런처(/var/opt/_devtools2/scripts/java/jdtls)를 통해 실행하도록 지정합니다.
      // - 주요 장점:
      //   1) JDTLS 구동 시 Lombok(-javaagent) 자동 주입 (Getter/Setter 어노테이션 미인식 오류 차단)
      //   2) DevTools2 필수 도구인 Neovim(Mason)에 사전 설치된 JDTLS/Lombok/Debugger 자원을
      //      1순위로 즉시 재사용하여 중복 다운로드 없이 100% 완전 오프라인에서도 즉시 구동
      //
      // ⚠️ [연동 방식: binary.path 가 아니라 Java 확장의 jdtls_launcher 설정 사용]
      //   예전처럼 "binary": { "path": 런처 } 로 지정하면 Zed 가 Java 확장을 거치지 않고 런처를 바로 실행해서,
      //   확장이 jdtls 를 띄울 때만 하는 디버거 플러그인 준비가 빠집니다 → F4 로 디버그 실행 시
      //   "RPC request GetDebugAdapterBinary failed: Debugger plugin is not loaded" 오류 (Goono-ELN 실측).
      //   jdtls_launcher 로 지정하면 확장이 평소대로 실행 과정(디버거 플러그인 준비 포함)을 거치면서 런처만 바꿔 씁니다.
      // ==============================================================================
      "settings": {
        // 전용 런처 (Mason 의 JDTLS·Lombok 재사용, 설치된 JDK 중 가장 높은 버전으로 실행 — 런처 상단 설명 참고)
        "jdtls_launcher": "/var/opt/_devtools2/scripts/java/jdtls",
        // 확장 자체의 Lombok 주입(다운로드 + -javaagent)은 끔: 런처가 Mason 의 lombok.jar 를 이미 주입하므로 중복 방지
        "lombok_support": false,
        // 📌 [jdk_auto_download 설정 상세 설명]
        // - false: JDTLS가 인터넷(RedHat/Eclipse)에서 별도의 JDK를 자동으로 추가 다운로드하지 못하게 차단하고,
        //          DevTools2 에 설치된 로컬 JDK 를 사용합니다 (jdtls 실행 JDK 는 런처가, 프로젝트 JDK 는 아래 runtimes 가 결정).
        "jdk_auto_download": false
      },
      "initialization_options": {
        // 🌟 [Java Debug Adapter 번들]
        // - JDTLS는 디버거 기능이 내장되어 있지 않아 Java Debug Plugin을 번들로 등록해야
        //   중단점(Breakpoint), 스텝 디버깅(F4)이 활성화됩니다.
        // - 이 번들은 Zed Java 확장이 직접 등록합니다(Zed 용으로 수정한 zed-industries/java-debug 포크, 최초 1회 다운로드).
        //   예전처럼 여기에 Microsoft 원본 플러그인(Mason)을 "bundles" 로 함께 넣으면 같은 디버그 명령을 두 플러그인이
        //   등록해 충돌할 수 있어 넣지 않습니다.
        "settings": {
          "java": {
            // 기본 자바 언어 서버 구동 JDK 지정 (Gradle 8 호환 JDK 21)
            "home": "/var/opt/_devtools2/modules/java/jdk-21",

            // 📌 [autobuild 설정 상세 설명]
            // - 프로젝트 오픈 또는 소스 변경 시 백그라운드 인덱싱/빌드를 즉시 자동 수행합니다.
            // - 특정 프로젝트(.zed/settings.json)에서만 켜고 싶다면 글로벌에서는 안 적거나 false로 두고,
            //   프로젝트 설정 파일(.zed/settings.json)에 `"autobuild": { "enabled": true }`를 넣어주시면 됩니다.
            "autobuild": {
              "enabled": true
            },
            "format": {
              "enabled": true,
              "tabSize": 4,
              "insertSpaces": true,
              "settings": {
                "url": "file:///var/opt/_devtools2/.config/formatter/java/s2-code-style.xml",
                "profile": "Standard-s2"
              },
              "comments": {
                "enabled": false
              }
            },
            "import": {
              "gradle": {
                "enabled": true,
                "wrapper": {
                  "enabled": true
                },
                "annotationProcessing": {
                  "enabled": true
                },
                "java": {
                  "home": "/var/opt/_devtools2/modules/java/jdk-21"
                }
              },
              "maven": {
                "enabled": true
              }
            },
            "configuration": {
              "updateBuildConfiguration": "automatic",
              "runtimes": [
                {
                  "name": "JavaSE-25",
                  "path": "/var/opt/_devtools2/modules/java/jdk-25"
                },
                {
                  "name": "JavaSE-21",
                  "path": "/var/opt/_devtools2/modules/java/jdk-21",
                  "default": true
                },
                {
                  "name": "JavaSE-17",
                  "path": "/var/opt/_devtools2/modules/java/jdk-17"
                },
                {
                  "name": "JavaSE-1.8",
                  "path": "/var/opt/_devtools2/modules/java/jdk-1.8"
                }
              ]
            },
            "completion": {
              "importOrder": [
                "java",
                "javax",
                "org",
                "com"
              ]
            }
          }
        }
      }
    }
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
