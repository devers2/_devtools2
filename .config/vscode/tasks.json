{
  // ==============================================================================
  // 🌟 DevTools2 VSCode 전역 사용자 태스크 (Command Palette 전용)
  // - Ctrl + Shift + P -> "Tasks: Run Task" (작업: 작업 실행) 메뉴에서 즉시 실행 가능합니다.
  // - WSL 원격 창(Remote - WSL)에서 실행하는 것을 전제로 합니다(Windows 로컬 폴더 창은 지원하지 않음).
  // ==============================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌟 [DevTools2] VSCode 확장 목록 동기화 저장 (Export Extensions)",
      "type": "shell",
      "command": "code --list-extensions | grep -E '^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$' > \"${DEVTOOLS2:-/var/opt/_devtools2}/.config/vscode/extensions.txt\" && echo \"✅ extensions.txt 저장 완료\"",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
