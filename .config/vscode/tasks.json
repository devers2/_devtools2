{
  // ==============================================================================
  // 🌟 DevTools2 VSCode 전역 사용자 태스크 (Command Palette 전용)
  // - Ctrl + Shift + P -> "Tasks: Run Task" (작업: 작업 실행) 메뉴에서 즉시 실행 가능합니다.
  // ==============================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌟 [DevTools2] VSCode 확장 목록 동기화 저장 (Export Extensions)",
      "type": "shell",
      "command": "code --list-extensions | grep -E '^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$' > \"${DEVTOOLS2:-/var/opt/_devtools2}/.config/vscode/extensions.txt\" && echo \"✅ extensions.txt 저장 완료\"",
      "windows": {
        "command": "powershell -Command \"code --list-extensions | Where-Object { $_ -match '^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$' } | Out-File -Encoding utf8 '$env:DEVTOOLS2\\.config\\vscode\\extensions.txt'\""
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
