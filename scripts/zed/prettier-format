#!/usr/bin/env bash
# ==============================================================================
# 🌟 [Zed 에디터 전용] Prettier 포맷 래퍼 (scripts/zed/prettier-format)
# ==============================================================================
#
# ■ 호출 경로:
#   .config/zed/settings.json → languages.<언어>.formatter.external
#   (Zed 가 버퍼 내용을 표준 입력으로 넘기고, 표준 출력으로 받은 결과로 바꿉니다. 인자: 파일 경로)
#
# ■ 왜 래퍼가 필요한가 (Neovim 과 같은 포맷 결과):
#   Neovim(plugins/formatting.lua)은 프로젝트에 Prettier 설정이 있으면 그것을, 없으면 DevTools2 공통 설정
#   (.config/prettier/.prettierrc.cjs — 작은따옴표·printWidth 100·SQL/XML/Jinja 플러그인 등)을 씁니다.
#   Zed 내장 Prettier 는 프로젝트 설정이 없을 때 Prettier 기본값(큰따옴표 등)으로 포맷해서 같은 파일이
#   편집기마다 다르게 정리됐습니다. 이 래퍼가 Neovim 과 같은 기준으로 설정을 고릅니다.
#
# ■ 동작:
#   1. Prettier 실행 파일: 프로젝트 node_modules/.bin/prettier 가 있으면 그것(프로젝트 버전 고정), 없으면 DevTools2 전역
#   2. 프로젝트 설정(.prettierrc*, prettier.config.*, package.json 의 "prettier")이 있으면 그 설정 그대로
#   3. 없으면 DevTools2 공통 설정 + 공통 .prettierignore
#   4. Prettier 를 찾지 못하면 입력을 그대로 돌려줌 (포맷만 건너뛰고 파일 내용은 절대 잃지 않음)
# ==============================================================================

FILE="${1:-}"
DEVTOOLS2="${DEVTOOLS2:-/var/opt/_devtools2}"

# ── 1. Prettier 실행 파일 (프로젝트 → DevTools2 전역) ─────────────────────────
PRETTIER=""
if [ -n "$FILE" ]; then
    d="$(dirname "$FILE")"
    while [ -n "$d" ] && [ "$d" != "/" ]; do
        if [ -x "$d/node_modules/.bin/prettier" ]; then
            PRETTIER="$d/node_modules/.bin/prettier"
            break
        fi
        d="$(dirname "$d")"
    done
fi
[ -n "$PRETTIER" ] || PRETTIER="$DEVTOOLS2/data/.npm-packages/bin/prettier"

if [ ! -x "$PRETTIER" ] || [ -z "$FILE" ]; then
    cat   # 4. Prettier 없음 → 원문 그대로
    exit 0
fi

# ── 실행 위치: 파일이 속한 프로젝트(git 루트, 없으면 파일 폴더) ────────────────
# Prettier 3 은 실행 위치의 .gitignore · .prettierignore 도 무시 목록으로 읽습니다. 다른 곳(예: .gitignore 가
# "*" 인 _devtools2)에서 실행되면 파일이 무시 대상이 되어 아무 포맷도 하지 않고 원문을 돌려줍니다(실측).
_dir="$(dirname "$FILE")"
cd "$(git -C "$_dir" rev-parse --show-toplevel 2>/dev/null || echo "$_dir")" 2>/dev/null || true

# ── 2·3. 설정 선택 (프로젝트 설정 우선, 없으면 DevTools2 공통 설정) ──────────
if "$PRETTIER" --find-config-path "$FILE" >/dev/null 2>&1; then
    exec "$PRETTIER" --stdin-filepath "$FILE"
fi
exec "$PRETTIER" \
    --config "$DEVTOOLS2/.config/prettier/.prettierrc.cjs" \
    --ignore-path "$DEVTOOLS2/.config/prettier/.prettierignore" \
    --stdin-filepath "$FILE"
