#!/usr/bin/env bash
# ==============================================================================
# 🌟 [Zed 에디터 전용] 포맷 래퍼 — Neovim(conform.nvim)과 같은 포맷 결과 (scripts/zed/format)
# ==============================================================================
#
# ■ 호출 경로:
#   .config/zed/settings.json → languages.<언어>.formatter.external
#     { "command": "/var/opt/_devtools2/scripts/zed/format", "arguments": ["<도구>", "{buffer_path}"] }
#   Zed 가 버퍼 내용을 표준 입력으로 넘기고, 표준 출력으로 받은 결과로 바꿉니다 (0 이 아닌 종료 코드면 적용 안 함).
#
# ■ 왜 필요한가:
#   Zed 내장/확장 포매터는 Neovim 과 도구·옵션이 달라 같은 파일이 편집기마다 다르게 정리됐습니다
#   (예: 프로젝트 Prettier 설정이 없으면 Prettier 기본값(큰따옴표), SQL 은 포맷 없음, XML·Kotlin 은 확장 자체 포매터).
#   이 래퍼는 Neovim(.config/nvim/lua/plugins/formatting.lua)과 같은 도구·인자·예외 처리를 씁니다.
#   ⚠️ formatting.lua 의 포매터 설정을 바꾸면 이 파일도 같이 맞춰 주세요.
#
# ■ 도구별 동작 (Neovim 과 동일):
#   prettier : 프로젝트에 Prettier 설정 "파일"(.prettierrc*, prettier.config.*)이 있으면 그 설정, 없으면 DevTools2 공통
#              .config/prettier/.prettierrc.cjs. 무시 목록은 쓰지 않음(--ignore-path "" — _devtools2 .gitignore 의 "*" 때문에
#              파일이 통째로 건너뛰어지는 문제 방지). 실행 파일은 프로젝트 node_modules/.bin/prettier 우선, 없으면 전역.
#   xml      : MyBatis 매퍼(*Mapper.xml, 또는 앞 25줄에 mybatis / <mapper)는 그대로 둠(동적 SQL 들여쓰기 보호),
#              그 밖의 XML 은 xmlformat --preserve <MyBatis 태그> -
#   sql      : sql-formatter
#   kotlin   : ktlint --format --stdin --log-level=none
#   lua      : stylua --config-path .config/nvim/stylua.toml (Neovim 과 같은 설정)
#
# ■ 안전 장치 (파일 내용을 잃지 않게):
#   - 도구가 설치되어 있지 않으면 입력을 그대로 돌려줌 (포맷만 건너뜀)
#   - 도구가 정상 종료했는데 출력이 비어 있으면(입력은 비어 있지 않은데) 실패로 처리
#     (ktlint 는 파싱에 실패해도 exit 0 + 빈 출력을 내는 버그가 있어, 그대로 적용하면 파일이 비워짐 —
#      Neovim formatting.lua 의 injected kotlin 제외 주석 참고)
# ==============================================================================

TOOL="${1:-}"
FILE="${2:-}"
DEVTOOLS2="${DEVTOOLS2:-/var/opt/_devtools2}"
MASON_BIN="$DEVTOOLS2/data/nvim/mason/bin"

# 표준 입력을 그대로 보관 (끝의 줄바꿈까지 유지하려고 sentinel 사용)
INPUT="$(cat; printf x)"
INPUT="${INPUT%x}"

passthrough() { printf '%s' "$INPUT"; exit 0; }

# 포매터 실행: 성공이면 결과 출력, 실패·빈 출력이면 오류 종료 (Zed 는 적용하지 않음)
run_formatter() {
    local out rc
    out="$(printf '%s' "$INPUT" | "$@"; rc=$?; printf x; exit $rc)"
    rc=$?
    out="${out%x}"
    if [ "$rc" -ne 0 ]; then
        exit "$rc"
    fi
    if [ -z "$out" ] && [ -n "$INPUT" ]; then
        echo "[zed format] $TOOL: 빈 결과 — 파일 내용 보호를 위해 적용하지 않음" >&2
        exit 1
    fi
    # 파일 끝 줄바꿈: Neovim 은 저장할 때 항상 마지막 줄바꿈을 붙이므로, 입력이 줄바꿈으로 끝났는데 결과에 없으면 붙임
    # (xmlformat 은 마지막 줄바꿈 없이 출력함 — Neovim 결과와 이 한 글자만 달랐음, 실측)
    if [ "${INPUT: -1}" = $'\n' ] && [ "${out: -1}" != $'\n' ]; then
        out="$out"$'\n'
    fi
    printf '%s' "$out"
    exit 0
}

case "$TOOL" in
    prettier)
        # 실행 파일: 프로젝트 node_modules/.bin → DevTools2 전역
        PRETTIER=""
        d="$(dirname "$FILE")"
        while [ -n "$d" ] && [ "$d" != "/" ]; do
            if [ -x "$d/node_modules/.bin/prettier" ]; then PRETTIER="$d/node_modules/.bin/prettier"; break; fi
            d="$(dirname "$d")"
        done
        [ -n "$PRETTIER" ] || PRETTIER="$DEVTOOLS2/data/.npm-packages/bin/prettier"
        [ -x "$PRETTIER" ] || passthrough
        # 프로젝트 Prettier 설정 파일 (Neovim find_local_prettier_config 와 같은 목록, 위쪽 폴더로 탐색)
        HAS_LOCAL=false
        d="$(dirname "$FILE")"
        while [ -n "$d" ]; do
            for c in .prettierrc .prettierrc.json .prettierrc.js .prettierrc.cjs .prettierrc.mjs .prettierrc.yaml \
                     .prettierrc.yml prettier.config.js prettier.config.cjs prettier.config.mjs; do
                if [ -e "$d/$c" ]; then HAS_LOCAL=true; break 2; fi
            done
            [ "$d" = "/" ] && break
            d="$(dirname "$d")"
        done
        if $HAS_LOCAL; then
            run_formatter "$PRETTIER" --ignore-path "" --stdin-filepath "$FILE"
        else
            run_formatter "$PRETTIER" --config "$DEVTOOLS2/.config/prettier/.prettierrc.cjs" --ignore-path "" --stdin-filepath "$FILE"
        fi
        ;;
    xml)
        case "$FILE" in *[Mm]apper.xml) passthrough ;; esac
        if printf '%s' "$INPUT" | head -n 25 | grep -qE 'mybatis|<mapper'; then
            passthrough
        fi
        [ -x "$MASON_BIN/xmlformat" ] || passthrough
        run_formatter "$MASON_BIN/xmlformat" --preserve \
            'select,insert,update,delete,sql,selectKey,if,choose,when,otherwise,where,set,trim,foreach,bind' -
        ;;
    sql)
        [ -x "$MASON_BIN/sql-formatter" ] || passthrough
        run_formatter "$MASON_BIN/sql-formatter"
        ;;
    kotlin)
        [ -x "$MASON_BIN/ktlint" ] || passthrough
        run_formatter "$MASON_BIN/ktlint" --format --stdin --log-level=none
        ;;
    lua)
        [ -x "$MASON_BIN/stylua" ] || passthrough
        run_formatter "$MASON_BIN/stylua" --config-path "$DEVTOOLS2/.config/nvim/stylua.toml" \
            --search-parent-directories --respect-ignores --stdin-filepath "$FILE" -
        ;;
    *)
        echo "[zed format] 알 수 없는 도구: $TOOL (prettier | xml | sql | kotlin | lua)" >&2
        exit 2
        ;;
esac
