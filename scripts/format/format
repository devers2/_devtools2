#!/usr/bin/env bash
# ==============================================================================
# 🌟 [편집기 공통] 포맷 래퍼 — Zed 가 Neovim(conform.nvim)과 같은 포맷 결과를 내도록 (scripts/format/format)
# ==============================================================================
#
# ■ 호출 경로:
#   .config/zed/settings.json → languages.<언어>.formatter.external
#     { "command": "/var/opt/_devtools2/scripts/format/format", "arguments": ["<도구>", "{buffer_path}"] }
#   Neovim 도 Kotlin 은 이 래퍼를 씁니다 (plugins/formatting.lua 의 formatters.ktlint — 아래 kotlin 안전 처리 때문).
#   (예전 위치: scripts/zed/format — Neovim 도 함께 쓰게 되어 공통 위치로 옮김)
#   Zed 가 버퍼 내용을 표준 입력으로 넘기고, 표준 출력으로 받은 결과로 바꿉니다 (0 이 아닌 종료 코드면 적용 안 함).
#
# ■ 왜 필요한가:
#   Zed 내장/확장 포매터는 Neovim 과 도구·옵션이 달라 같은 파일이 편집기마다 다르게 정리됐습니다
#   (예: 프로젝트 Prettier 설정이 없으면 Prettier 기본값(큰따옴표), SQL 은 포맷 없음, XML·Kotlin 은 확장 자체 포매터).
#   이 래퍼는 Neovim(.config/nvim/lua/plugins/formatting.lua)과 같은 도구·인자·예외 처리를 씁니다.
#   ⚠️ formatting.lua 의 포매터 설정을 바꾸면 이 파일도 같이 맞춰 주세요.
#
# ■ 도구별 동작 (Neovim 과 동일):
#   prettier : 프로젝트에 Prettier 설정(.prettierrc*, prettier.config.*, package.json 의 "prettier")이 있으면 그 설정, 없으면 DevTools2 공통
#              .config/prettier/.prettierrc.cjs. 무시 목록은 쓰지 않음(--ignore-path "" — _devtools2 .gitignore 의 "*" 때문에
#              파일이 통째로 건너뛰어지는 문제 방지). 실행 파일은 프로젝트 node_modules/.bin/prettier 우선, 없으면 전역.
#   xml      : MyBatis 매퍼(*Mapper.xml, 또는 앞 25줄에 mybatis / <mapper)는 그대로 둠(동적 SQL 들여쓰기 보호),
#              그 밖의 XML 은 xmlformat --preserve <MyBatis 태그> -
#   sql      : sql-formatter
#   kotlin   : ktlint --stdin-path <파일> --format --stdin --log-level=none (파일이 속한 프로젝트의 .editorconfig 적용)
#   lua      : stylua — 프로젝트에 stylua.toml / .stylua.toml 이 있으면 그 설정, 없으면 .config/nvim/stylua.toml
#
# ■ 안전 장치 (파일 내용을 잃지 않게):
#   - 도구가 설치되어 있지 않으면 입력을 그대로 돌려줌 (포맷만 건너뜀)
#   - 도구가 정상 종료했는데 출력이 비어 있으면(입력은 비어 있지 않은데) 실패로 처리
#     (ktlint 는 파싱에 실패해도 exit 0 + 빈 출력을 내는 버그가 있어, 그대로 적용하면 파일이 비워짐 —
#      Neovim formatting.lua 의 injected kotlin 제외 주석 참고)
# ==============================================================================

TOOL="${1:-}"
FILE="${2:-}"
DEVTOOLS2="${DEVTOOLS2:-/var/opt/_devtools2}"
MASON_BIN="$DEVTOOLS2/data/nvim/mason/bin"

# 표준 입력을 그대로 보관 (끝의 줄바꿈까지 유지하려고 sentinel 사용)
INPUT="$(cat; printf x)"
INPUT="${INPUT%x}"

passthrough() { printf '%s' "$INPUT"; exit 0; }

# 포매터 실행: 성공이면 결과 출력, 실패·빈 출력이면 오류 종료 (Zed 는 적용하지 않음)
# OK_EXIT_CODES: 성공으로 볼 종료 코드 목록 (기본 "0" — ktlint 는 "0 1", 아래 kotlin 설명)
run_formatter() {
    local out rc
    out="$(printf '%s' "$INPUT" | "$@"; rc=$?; printf x; exit $rc)"
    rc=$?
    out="${out%x}"
    case " ${OK_EXIT_CODES:-0} " in
        *" $rc "*) ;;
        *) exit "$rc" ;;
    esac
    if [ -z "$out" ] && [ -n "$INPUT" ]; then
        echo "[zed format] $TOOL: 빈 결과 — 파일 내용 보호를 위해 적용하지 않음" >&2
        exit 1
    fi
    # 파일 끝 줄바꿈: Neovim 은 저장할 때 항상 마지막 줄바꿈을 붙이므로, 입력이 줄바꿈으로 끝났는데 결과에 없으면 붙임
    # (xmlformat 은 마지막 줄바꿈 없이 출력함 — Neovim 결과와 이 한 글자만 달랐음, 실측)
    if [ "${INPUT: -1}" = $'\n' ] && [ "${out: -1}" != $'\n' ]; then
        out="$out"$'\n'
    fi
    printf '%s' "$out"
    exit 0
}

case "$TOOL" in
    prettier)
        # 실행 파일: 프로젝트 node_modules/.bin → DevTools2 전역
        PRETTIER=""
        d="$(dirname "$FILE")"
        while [ -n "$d" ] && [ "$d" != "/" ]; do
            if [ -x "$d/node_modules/.bin/prettier" ]; then PRETTIER="$d/node_modules/.bin/prettier"; break; fi
            d="$(dirname "$d")"
        done
        [ -n "$PRETTIER" ] || PRETTIER="$DEVTOOLS2/data/.npm-packages/bin/prettier"
        [ -x "$PRETTIER" ] || passthrough
        # 프로젝트 Prettier 설정 (Neovim find_local_prettier_config 와 같은 기준, 위쪽 폴더로 탐색):
        #   설정 파일(.prettierrc* / prettier.config.*) 또는 package.json 최상위의 "prettier" 설정
        #   (package.json 은 JSON 으로 읽어 최상위 키 확인 — devDependencies 의 "prettier" 는 설정이 아님)
        HAS_LOCAL=false
        d="$(dirname "$FILE")"
        while [ -n "$d" ]; do
            for c in .prettierrc .prettierrc.json .prettierrc.json5 .prettierrc.js .prettierrc.cjs .prettierrc.mjs \
                     .prettierrc.ts .prettierrc.cts .prettierrc.mts .prettierrc.yaml .prettierrc.yml .prettierrc.toml \
                     prettier.config.js prettier.config.cjs prettier.config.mjs \
                     prettier.config.ts prettier.config.cts prettier.config.mts; do
                if [ -e "$d/$c" ]; then HAS_LOCAL=true; break 2; fi
            done
            if [ -f "$d/package.json" ] && python3 -c 'import json,sys; sys.exit(0 if isinstance(json.load(open(sys.argv[1])), dict) and "prettier" in json.load(open(sys.argv[1])) else 1)' "$d/package.json" 2>/dev/null; then
                HAS_LOCAL=true; break
            fi
            [ "$d" = "/" ] && break
            d="$(dirname "$d")"
        done
        if $HAS_LOCAL; then
            run_formatter "$PRETTIER" --ignore-path "" --stdin-filepath "$FILE"
        else
            run_formatter "$PRETTIER" --config "$DEVTOOLS2/.config/prettier/.prettierrc.cjs" --ignore-path "" --stdin-filepath "$FILE"
        fi
        ;;
    xml)
        case "$FILE" in *[Mm]apper.xml) passthrough ;; esac
        if printf '%s' "$INPUT" | head -n 25 | grep -qE 'mybatis|<mapper'; then
            passthrough
        fi
        [ -x "$MASON_BIN/xmlformat" ] || passthrough
        run_formatter "$MASON_BIN/xmlformat" --preserve \
            'select,insert,update,delete,sql,selectKey,if,choose,when,otherwise,where,set,trim,foreach,bind' -
        ;;
    sql)
        [ -x "$MASON_BIN/sql-formatter" ] || passthrough
        run_formatter "$MASON_BIN/sql-formatter"
        ;;
    kotlin)
        [ -x "$MASON_BIN/ktlint" ] || passthrough
        # --stdin-path: 그 파일이 속한 프로젝트의 .editorconfig 적용
        # 종료 코드 1 도 성공으로 봄: ktlint 는 포맷을 마치고 결과를 출력한 뒤에도 "자동으로 고칠 수 없는 규칙 위반"
        #   (예: 파일 이름 PascalCase, import foo.*)이 남으면 1 을 냅니다. 이를 실패로 보면 포맷 결과 전체를 버려서
        #   Kotlin 파일이 전혀 정리되지 않았음(실측). 파싱 실패(빈 출력)는 아래 빈 결과 검사가 막음.
        OK_EXIT_CODES="0 1" run_formatter "$MASON_BIN/ktlint" --stdin-path "$FILE" --format --stdin --log-level=none
        ;;
    lua)
        [ -x "$MASON_BIN/stylua" ] || passthrough
        # 프로젝트에 stylua.toml / .stylua.toml 이 있으면 그 설정, 없으면 Neovim 의 stylua.toml (Neovim 과 같은 기준)
        STYLUA_CFG=()
        d="$(dirname "$FILE")"; HAS_STYLUA=false
        while [ -n "$d" ]; do
            if [ -e "$d/stylua.toml" ] || [ -e "$d/.stylua.toml" ]; then HAS_STYLUA=true; break; fi
            [ "$d" = "/" ] && break
            d="$(dirname "$d")"
        done
        $HAS_STYLUA || STYLUA_CFG=(--config-path "$DEVTOOLS2/.config/nvim/stylua.toml")
        run_formatter "$MASON_BIN/stylua" "${STYLUA_CFG[@]}" \
            --search-parent-directories --respect-ignores --stdin-filepath "$FILE" -
        ;;
    *)
        echo "[zed format] 알 수 없는 도구: $TOOL (prettier | xml | sql | kotlin | lua)" >&2
        exit 2
        ;;
esac
