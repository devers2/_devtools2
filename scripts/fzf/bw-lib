# ── 폴더명으로 일치하는 폴더 ID 목록 반환 (공백 구분) ─────────────────────────
# 인수: $1 = 폴더명 (정확 일치)
# 출력: 폴더 ID 목록 (공백 구분) → 일치 없으면 빈 문자열
bw_get_folder_ids() {
    local _FOLDER_NAME="$1"
    local _FOLDERS_JSON _ERR_FILE _RC
    _ERR_FILE=$(mktemp)

    _FOLDERS_JSON=$(bw list folders </dev/null 2>"$_ERR_FILE")
    _RC=$?

    if [ $_RC -ne 0 ]; then
        if grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE" "$_ERR_FILE"; then
            echo "❌ Bitwarden 세션이 만료되었습니다." >&2
            rm -f "$_BW_SESSION_FILE"
        fi
        rm -f "$_ERR_FILE"
        return 1
    fi
    rm -f "$_ERR_FILE"

    # ⚠️ 폴더명을 파이썬 소스에 문자열로 직접 이어붙이지 않고 sys.argv로 전달합니다.
    # (bw_find_item_by_name / bw_get_fields와 동일한 안전한 패턴 — 폴더명에 따옴표 등
    # 특수문자가 섞여 들어와도 파이썬 코드로 해석되지 않습니다.)
    echo "$_FOLDERS_JSON" | python3 -c "
import sys, json

try:
    raw = sys.stdin.read()
    start = raw.find('[')
    end = raw.rfind(']')
    if start != -1 and end != -1 and start < end:
        folders = json.loads(raw[start:end+1], strict=False)
        target = sys.argv[1].strip()
        matched = [f.get('id','') for f in folders if isinstance(f, dict) and str(f.get('name','')).strip() == target and f.get('id')]
        print(' '.join(matched))
except Exception:
    pass
" "$_FOLDER_NAME" 2>/dev/null
}

# ── 폴더명으로 아이템 전체 조회 후 RAW_ITEMS_LIST 반환 ────────────────────────
# 인수: $1 = 폴더명
# 출력: ---ITEM_SPLIT--- 로 구분된 JSON 청크 문자열
# 반환: 0 = 성공, 1 = 세션 오류
bw_get_items_by_folder_name() {
    local _FOLDER_NAME="$1"
    local _FOLDER_IDS _ITEMS _RAW=""

    _FOLDER_IDS=$(bw_get_folder_ids "$_FOLDER_NAME") || return 1

    if [ -z "$_FOLDER_IDS" ]; then
        return 0
    fi

    for _FID in $_FOLDER_IDS; do
        local _ERR_FILE _RC
        _ERR_FILE=$(mktemp)
        _ITEMS=$(bw list items --folderid "$_FID" </dev/null 2>"$_ERR_FILE")
        _RC=$?
        if [ $_RC -ne 0 ]; then
            if grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE" "$_ERR_FILE"; then
                echo "❌ Bitwarden 세션이 만료되었습니다." >&2
                rm -f "$_BW_SESSION_FILE"
            fi
            rm -f "$_ERR_FILE"
            return 1
        fi
        rm -f "$_ERR_FILE"
        if [ -n "$_ITEMS" ] && [ "$_ITEMS" != "[]" ]; then
            _RAW="${_RAW}${_ITEMS}"$'\n---ITEM_SPLIT---\n'
        fi
    done

    printf "%s" "$_RAW"
}

# ── 이름이 정확히 일치하는 아이템의 필드를 추출 ───────────────────────────────
# 인수: $1 = RAW_ITEMS_LIST (---ITEM_SPLIT--- 구분 문자열)
#       $2 = 찾을 아이템 이름 (정확 일치)
# 출력: username\temail\tpassword\tpat\tnotes (탭 구분)
#   username: 사용자 지정 필드 "user.name" 값이 있으면 그 값, 없으면 login.username(이메일)의 @ 앞부분
#   email   : 사용자 지정 필드 "user.email" 값이 있으면 그 값, 없으면 login.username(이메일) 그대로
#   pat     : 사용자 지정 필드 중 라벨이 "PAT"인 필드의 값
#   (필드 라벨 매칭은 대소문자/앞뒤공백 무관 — 계정마다 다른 Bitwarden 볼트에서도 라벨만 맞으면 동작)
# 반환: 0 = 성공(일치 0개 또는 1개), 3 = 이름이 정확히 일치하는 아이템이 2개 이상(중복)
#   일치 항목이 없으면 빈 출력 + 종료코드 0
bw_find_item_by_name() {
    local _RAW="$1"
    local _TARGET_NAME="$2"

    # 임시 파이썬 스크립트로 파싱 (stdin 충돌 방지)
    local _PY
    _PY=$(mktemp /tmp/bw_find_XXXXXX.py)
    cat > "$_PY" <<'PYEOF'
import sys, json

raw_all = sys.stdin.read()
target_name = sys.argv[1] if len(sys.argv) > 1 else ''

matches = []
chunks = raw_all.split('---ITEM_SPLIT---')
for chunk in chunks:
    chunk = chunk.strip()
    if not chunk:
        continue
    start = chunk.find('[')
    end = chunk.rfind(']')
    if start == -1 or end == -1 or start >= end:
        continue
    try:
        items = json.loads(chunk[start:end+1], strict=False)
    except Exception:
        continue
    for item in items:
        if isinstance(item, dict) and str(item.get('name', '')).strip() == target_name:
            matches.append(item)

if len(matches) > 1:
    sys.exit(3)

if len(matches) == 1:
    item = matches[0]
    login = item.get('login') or {}
    login_username = login.get('username') or ''
    password = login.get('password') or ''

    field_map = {}
    for f in (item.get('fields') or []):
        if isinstance(f, dict):
            key = str(f.get('name') or '').strip().lower()
            field_map[key] = f.get('value') or ''

    pat = field_map.get('pat', '')
    custom_username = field_map.get('user.name', '')
    custom_email = field_map.get('user.email', '')

    username = custom_username if custom_username else login_username.split('@')[0]
    email = custom_email if custom_email else login_username

    notes = str(item.get('notes') or '')
    print(f"{username}\t{email}\t{password}\t{pat}\t{notes}")
PYEOF

    printf "%s" "$_RAW" | python3 "$_PY" "$_TARGET_NAME"
    local _RC=$?
    rm -f "$_PY"
    return $_RC
}

# ── 아이템 이름으로 실시간 조회 + 필드 파싱까지 한 번에 수행 ───────────────────
# (bw list items --search → 세션 만료 감지 → bw_find_item_by_name 파싱을 묶은 상위 래퍼.
#  bw_git_clone / setup_gpr_gradle_properties(common-setup.sh)가 각자 이 글루 코드를
#  복붙해 쓰고 있던 걸 한 곳으로 모음)
# 인수: $1 = 찾을 아이템 이름 (정확 일치)
# 출력: username\temail\tpassword\tpat\tnotes (탭 구분, bw_find_item_by_name과 동일 포맷)
# 반환: 0 = 성공, 1 = 세션 만료 / 아이템 없음 / 아이템 2개 이상(중복)
# 전제: BW_SESSION 이 유효한 상태여야 함
#   실패 시 원인(세션 만료 / 미발견 / 중복)에 맞는 에러 메시지를 stderr에 출력합니다.
#   조용히 실패시키고 싶으면 호출부에서 2>/dev/null 로 감싸세요 (예: common-setup.sh의
#   선택적 조회처럼 "없으면 그냥 넘어가는" 흐름).
# 내부 헬퍼: 아이템 이름으로 실시간 조회 + 세션 만료 감지까지 수행 (Raw JSON 반환)
# bw_find_item_live / bw_get_fields 가 공유하는 글루 코드
# 반환: 0 = 성공, 1 = 세션 만료
_bw_search_raw() {
    local _ITEM_NAME="$1"
    local _RAW _ERR_FILE _RC
    _ERR_FILE=$(mktemp)
    _RAW=$(bw list items --search "$_ITEM_NAME" </dev/null 2>"$_ERR_FILE")
    _RC=$?
    if [ $_RC -ne 0 ]; then
        if grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE" "$_ERR_FILE"; then
            echo "❌ Bitwarden 세션이 만료되었습니다. 다시 실행해주세요." >&2
            rm -f "$_BW_SESSION_FILE"
        fi
        rm -f "$_ERR_FILE"
        return 1
    fi
    rm -f "$_ERR_FILE"
    printf "%s" "$_RAW"
}

bw_find_item_live() {
    local _ITEM_NAME="$1"
    local _ALL_ITEMS_RAW
    _ALL_ITEMS_RAW=$(_bw_search_raw "$_ITEM_NAME") || return 1
    local _PARSED
    _PARSED=$(bw_find_item_by_name "${_ALL_ITEMS_RAW}"$'\n---ITEM_SPLIT---\n' "$_ITEM_NAME")
    local _RC=$?
    if [ $_RC -eq 3 ]; then
        echo "❌ Bitwarden에서 '${_ITEM_NAME}' 이름과 정확히 일치하는 항목이 2개 이상 있습니다." >&2
        echo "   항목 이름을 고유하게 정리한 뒤 다시 시도해주세요." >&2
        return 1
    fi
    if [ -z "$_PARSED" ]; then
        echo "❌ Bitwarden에서 '${_ITEM_NAME}' 항목을 찾을 수 없습니다." >&2
        return 1
    fi
    printf "%s" "$_PARSED"
}

# ── 아이템 이름 + 사용자 지정 필드 라벨 목록으로 값들을 한 번에 조회 ───────────
# login.username/password/totp 처럼 고정된 필드가 아니라, 아이템의 "사용자 지정
# 필드"(fields) 중 원하는 라벨들의 값만 골라 가져올 때 사용합니다
# (Maven Central Portal의 centralUsername/centralPassword, GPG Signing의
#  signing.keyId/signing.password/signing.secretKeyRingBase64 등 임의 필드 조합).
# 인수: $1 = 아이템 이름 (정확 일치), $2.. = 조회할 필드 라벨 목록 (대소문자/공백 무관 매칭)
# 출력: 요청한 순서대로 탭 구분 값 (아이템/필드가 없으면 해당 자리는 빈 문자열)
# 반환: 0 = 조회 성공(필드 값 존재 여부와 무관), 1 = 세션 만료
bw_get_fields() {
    local _ITEM_NAME="$1"
    shift
    local _FIELD_NAMES=("$@")

    local _RAW
    _RAW=$(_bw_search_raw "$_ITEM_NAME") || return 1

    local _PY
    _PY=$(mktemp /tmp/bw_fields_XXXXXX.py)
    cat > "$_PY" <<'PYEOF'
import sys, json

target_name = sys.argv[1]
field_names = sys.argv[2:]

raw = sys.stdin.read()
start = raw.find('[')
end = raw.rfind(']')

found = None
if start != -1 and end != -1 and start < end:
    try:
        items = json.loads(raw[start:end+1], strict=False)
        for item in items:
            if isinstance(item, dict) and str(item.get('name', '')).strip() == target_name:
                found = item
                break
    except Exception:
        pass

field_map = {}
if found:
    for f in (found.get('fields') or []):
        if isinstance(f, dict):
            key = str(f.get('name') or '').strip().lower()
            field_map[key] = f.get('value') or ''

values = [field_map.get(fn.strip().lower(), '') for fn in field_names]
print('\t'.join(values))
PYEOF

    printf "%s" "$_RAW" | python3 "$_PY" "$_ITEM_NAME" "${_FIELD_NAMES[@]}"
    rm -f "$_PY"
}

# ── git 전역 설정 (user.name / user.email) ────────────────────────────────────
# 인수:
#   $1 = 기본 user.name (Bitwarden 이메일의 @ 앞 부분, @ 제거된 값)
#   $2 = 기본 user.email (Bitwarden 이메일)
# 동작:
#   - user.name 또는 user.email 이 없는 경우에만 대화형 입력 실행
#   - Bitwarden 기본값을 제안하며 사용자 입력을 받음
#   - core.quotepath, credential.helper 도 함께 설정
# 반환: 0 = 성공 (설정 완료 또는 이미 존재)
bw_setup_git_config() {
    local _bw_default_name="${1:-}"
    local _bw_default_email="${2:-}"

    local _cur_git_name _cur_git_email
    _cur_git_name=$(git config --global user.name 2>/dev/null || echo "")
    _cur_git_email=$(git config --global user.email 2>/dev/null || echo "")

    if [ -n "$_cur_git_name" ] && [ -n "$_cur_git_email" ]; then
        echo "ℹ️  git 전역 설정이 이미 존재합니다:"
        echo "   user.name  = $_cur_git_name"
        echo "   user.email = $_cur_git_email"
        return 0
    fi

    echo "⚙️  git 전역 기본 설정(user.name / user.email)을 입력해주세요."
    echo "   [엔터]를 누르면 Bitwarden 기본값이 적용됩니다."
    echo ""
    local _input_git_name _input_git_email
    prompt_text _input_git_name "👤 user.name " "$_bw_default_name"
    prompt_text _input_git_email "📧 user.email" "$_bw_default_email"

    local _final_git_name _final_git_email
    _final_git_name="${_input_git_name:-$_bw_default_name}"
    _final_git_email="${_input_git_email:-$_bw_default_email}"
    # 이름에서 @ 문자 제거 (혹시 포함 시)
    _final_git_name=$(echo "$_final_git_name" | tr -d '@')

    git config --global user.name "$_final_git_name"
    git config --global user.email "$_final_git_email"
    git config --global core.quotepath false
    git config --global credential.helper store
    echo ""
    echo "✅ git config 전역 설정이 완료되었습니다:"
    echo "   user.name         = $_final_git_name"
    echo "   user.email        = $_final_git_email"
    echo "   core.quotepath    = false"
    echo "   credential.helper = store"
}

# ── git 인증 정보 저장 (~/.git-credentials) ──────────────────────────────────
# 인수:
#   $1 = 저장소 URL (host 추출에 사용, 예: https://github.com/user/repo.git)
#   $2 = PAT 토큰 (Bitwarden에서 가져온 값)
#   $3 = git user.name (@ 제거된 값, credential user 로 사용)
# 동작:
#   [기존 PAT 없음]  → 저장 여부 질의 후 저장
#   [기존 PAT 동일]  → 이미 최신임을 알리고 스킵
#   [기존 PAT 다름]  → 교체 여부 질의 후 교체
# 반환: 0 = 성공
bw_save_git_credentials() {
    local _repo_url="${1:-}"
    local _pat="${2:-}"
    local _username="${3:-}"

    if [ -z "$_pat" ]; then
        return 0
    fi

    local _cred_host
    _cred_host=$(echo "$_repo_url" | sed -E 's|^https?://||' | cut -d'/' -f1)

    # git config user.name 우선, 없으면 전달된 username 사용 (@ 제거 보장)
    local _cred_user
    _cred_user=$(git config --global user.name 2>/dev/null || echo "$_username")
    _cred_user=$(echo "$_cred_user" | tr -d '@')

    # ── 기존 credential 확인 ──────────────────────────────────────────────────
    local _existing_line=""
    if [ -f ~/.git-credentials ]; then
        _existing_line=$(grep -E "@${_cred_host}(/|:|$)" ~/.git-credentials 2>/dev/null | head -1 || echo "")
    fi

    local _save_ans
    if [ -n "$_existing_line" ]; then
        # 기존 PAT 추출 (형식: https://user:PAT@host)
        local _existing_pat
        _existing_pat=$(echo "$_existing_line" | sed -E 's|^https?://[^:]+:([^@]+)@.*|\1|')

        if [ "$_existing_pat" = "$_pat" ]; then
            echo "ℹ️  ~/.git-credentials 에 동일한 PAT 가 이미 저장되어 있습니다. (host: $_cred_host)"
            return 0
        fi

        echo "⚠️  ~/.git-credentials 에 ${_cred_host} 의 기존 PAT 가 있으나 Bitwarden PAT 와 다릅니다."
        prompt_confirm "🔄 기존 PAT 를 Bitwarden PAT 로 교체하시겠습니까?" "N" && _save_ans="y" || _save_ans="n"
    else
        prompt_confirm "🔑 이후 git push/pull 시에도 자동 인증되도록 PAT 를 저장하시겠습니까?" "Y" && _save_ans="y" || _save_ans="n"
    fi

    if [[ "$_save_ans" != "y" ]]; then
        echo "ℹ️  인증 정보를 변경하지 않았습니다."
        return 0
    fi

    local _cred_line="https://${_cred_user}:${_pat}@${_cred_host}"
    local _tmp_creds
    _tmp_creds=$(umask 077 && mktemp /tmp/bw_cred_XXXXXX 2>/dev/null || mktemp)
    _bw_trap_save
    trap 'rm -f "$_tmp_creds"' EXIT INT TERM
    (umask 077 && touch ~/.git-credentials)
    chmod 600 ~/.git-credentials 2>/dev/null || true
    grep -v -E "@${_cred_host}(/|:|$)" ~/.git-credentials > "$_tmp_creds" 2>/dev/null || true
    echo "$_cred_line" >> "$_tmp_creds"
    chmod 600 "$_tmp_creds"
    mv "$_tmp_creds" ~/.git-credentials
    _bw_trap_restore
    echo "✅ PAT 가 ~/.git-credentials 에 저장되었습니다. (host: $_cred_host)"

    # ── WSL2 환경: Windows 홈의 .git-credentials 에도 동기화 ──────────────────
    # Windows 네이티브 Git GUI(Sublime Merge 등)가 시스템 git.exe 의
    # credential.helper=store 를 통해 동일한 PAT 로 인증할 수 있도록 동기화한다.
    if grep -qi 'microsoft' /proc/version 2>/dev/null; then
        local _win_home=""
        if command -v get_win_userprofile >/dev/null 2>&1; then
            _win_home=$(get_win_userprofile 2>/dev/null || true)
        fi
        if [ -z "$_win_home" ]; then
            if command -v cmd.exe >/dev/null 2>&1; then
                local _raw
                _raw=$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r' || true)
                [ -n "$_raw" ] && command -v wslpath >/dev/null 2>&1 && _win_home=$(wslpath "$_raw" 2>/dev/null || true)
            fi
            [ -z "$_win_home" ] && [ -d "/mnt/c/Users/${USER:-}" ] && _win_home="/mnt/c/Users/${USER:-}"
        fi
        if [ -n "$_win_home" ] && [ -d "$_win_home" ]; then
            local _win_cred="$_win_home/.git-credentials"
            local _win_tmp
            _win_tmp=$(umask 077 && mktemp /tmp/bw_wincred_XXXXXX 2>/dev/null || mktemp)
            touch "$_win_cred" 2>/dev/null || true
            grep -v -E "@${_cred_host}(/|:|$)" "$_win_cred" > "$_win_tmp" 2>/dev/null || true
            echo "$_cred_line" >> "$_win_tmp"
            mv "$_win_tmp" "$_win_cred"
            echo "✅ Windows 측 $( echo "$_win_cred" | sed "s|$_win_home|~|" ) 에도 동기화 완료 (Windows Git GUI 인증 자동화)"
        fi
    fi
}

# ── GitHub 로그인 상태 확인 / gh CLI 로그인 / 일괄 설정 (설치 스크립트·프로젝트 설정 공용) ──
# 예전에는 GitHub 로그인(git 자격 증명)이 프로젝트 clone(bw_git_clone) 의 부산물로만 설정되었습니다.
# 이제 설치 스크립트(3.install-cli-tools.sh)에서 GitHub CLI(gh)와 함께 한 번에 설정하고,
# 프로젝트 설정 스크립트는 로그인이 안 되어 있을 때만 폴백으로 설정합니다(bw_git_clone_with_fallback).

# ~/.git-credentials 에 해당 호스트 로그인이 있는지 (반환: 0 = 있음)
bw_git_credentials_exist() {
    local _host="${1:-github.com}"
    [ -f ~/.git-credentials ] && grep -qE "@${_host}(/|:|$)" ~/.git-credentials 2>/dev/null
}

# GitHub CLI(gh) 가 해당 호스트에 로그인되어 있는지 (반환: 0 = 로그인됨 또는 gh 미설치)
bw_gh_auth_ok() {
    local _host="${1:-github.com}"
    command -v gh >/dev/null 2>&1 || return 0
    gh auth status --hostname "$_host" >/dev/null 2>&1
}

# PAT 로 GitHub CLI(gh) 로그인 (gh 미설치·이미 로그인이면 건너뜀)
# ⚠️ 토큰은 명령 인자가 아니라 표준입력(--with-token)으로만 넘깁니다(ps//proc 노출 방지).
# ⚠️ WSL·서버에는 OS 키링이 없어 gh 가 토큰을 ~/.config/gh/hosts.yml 에 평문 저장하므로 소유자 전용(700/600)으로 맞춥니다.
# ⚠️ gh 가 git 자격 증명 도우미를 바꾸지 않도록 'gh auth setup-git' 은 실행하지 않습니다(~/.git-credentials 를 그대로 사용).
bw_setup_gh_auth() {
    local _pat="${1:-}" _host="${2:-github.com}"
    [ -n "$_pat" ] || return 0
    command -v gh >/dev/null 2>&1 || return 0
    if gh auth status --hostname "$_host" >/dev/null 2>&1; then
        echo "ℹ️  GitHub CLI(gh) 가 이미 로그인되어 있습니다. (host: $_host)"
        return 0
    fi
    if printf '%s' "$_pat" | gh auth login --hostname "$_host" --git-protocol https --with-token >/dev/null 2>&1; then
        chmod 700 "$HOME/.config/gh" 2>/dev/null || true
        chmod 600 "$HOME/.config/gh/"*.yml 2>/dev/null || true
        echo "✅ GitHub CLI(gh) 로그인 완료 (host: $_host)"
    else
        echo "⚠️  GitHub CLI(gh) 로그인에 실패했습니다. PAT 권한(classic 이면 repo, read:org)을 확인하거나 'gh auth login' 으로 직접 로그인하세요."
    fi
    return 0
}

# ── Bitwarden 로그인 (이메일 · 마스터 비밀번호 · 2단계 인증/새 기기 확인 코드를 각각 3번까지) ─────────
# 예전에는 bw login --raw 가 세 가지를 한 번에 묻고, 하나라도 틀리면(예: 이메일 대신 아이디 입력) 바로 실패해
# GitHub 로그인 연결 전체를 건너뛰었습니다. 이제 단계별로 따로 묻고 틀린 단계만 다시 입력받습니다.
#   ● 이메일: 형식을 먼저 확인 (bw 의 "Email address is invalid." 와 같은 조건)
#   ● 비밀번호: bw login --nointeraction 으로 확인 → "Invalid master password" 면 비밀번호만 다시 입력
#     (비밀번호는 --passwordenv 로만 전달 — 프로세스 인자 노출 금지)
#   ● 코드: 이메일·비밀번호가 맞고 "Code is required." 이면(2단계 인증 또는 새 PC 의 새 기기 확인 메일 코드)
#     bw 가 직접 방법 선택·코드 입력을 묻게 합니다(코드를 프로세스 인자로 넘기지 않기 위함). 틀리면 다시 시도.
#     메일 코드는 시도할 때마다 새로 발송되므로 가장 최근 메일의 코드를 입력합니다.
# 성공하면 BW_SESSION 을 설정하고 세션 파일(소유자 전용 600)에 저장합니다. 반환: 0 = 성공, 1 = 실패
bw_interactive_login() {
    local _email="" _pw="" _out="" _err="" _try _status="" _errf
    normalize_tty
    _errf=$(mktemp) || return 1

    # 1) 이메일 (비밀번호가 틀렸을 때 e 로 다시 고칠 수 있도록 함수로 둠 — _email 에 결과 저장)
    _bw_login_ask_email() {
        local _t
        for _t in 1 2 3; do
            prompt_text _email "📧 Bitwarden 이메일 주소"
            _email="${_email//[[:space:]]/}"
            if [[ "$_email" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
                return 0
            fi
            echo "❌ 이메일 주소 형식이 아닙니다 (예: name@example.com). (${_t}/3)" >&2
            _email=""
        done
        return 1
    }
    _bw_login_ask_email || { rm -f "$_errf"; unset -f _bw_login_ask_email; return 1; }

    # 2) 마스터 비밀번호 (비대화형으로 확인해 틀린 경우만 다시 입력)
    #    Bitwarden 은 이메일이 틀려도(없는 계정) "Invalid master password" 로만 답하므로, 비밀번호가 틀리면
    #    비밀번호(p, 기본값) / 이메일(e) 중 다시 입력할 것을 고르게 합니다(공용 prompt_key — [P/e] 표시).
    #    틀린 횟수는 이메일을 바꿔도 이어서 세며, 합쳐서 3번 틀리면 이메일·비밀번호를 확인하고
    #    다시 진행하라고 안내한 뒤 넘어갑니다(마지막 기회에도 같은 질문 — 비밀번호·이메일 모두 고칠 수 있음).
    local _ans=""
    _try=0
    while [ "$_try" -lt 3 ]; do
        _try=$((_try + 1))
        _pw=""
        if command -v prompt_password &>/dev/null; then
            prompt_password _pw "🔐 Bitwarden 마스터 비밀번호 입력 (보안 마스킹): 🔒"
        else
            read -rsp "🔐 Bitwarden 마스터 비밀번호 입력 (보안 마스킹): 🔒 " _pw </dev/tty
            echo ""
            if has_non_ascii "$_pw"; then
                echo "❌ 비밀번호에 '비영문(한글/다국어/전각)' 문자가 있습니다. 영문 입력 상태로 다시 입력해 주세요. (${_try}/3)" >&2
                continue
            fi
        fi
        [ -n "$_pw" ] || { echo "❌ 비밀번호가 입력되지 않았습니다. (${_try}/3)" >&2; continue; }
        echo "🔑 Bitwarden 로그인 확인 중..."
        _out=$(BW_PASSWORD="$_pw" bw login "$_email" --passwordenv BW_PASSWORD --raw --nointeraction 2>"$_errf") && { _status="ok"; break; }
        _err=$(cat "$_errf" 2>/dev/null)
        case "$_err" in
            *"Code is required"*|*"No provider selected"*) _status="code"; break ;;
            *"Invalid master password"*|*"incorrect"*)
                echo "❌ 마스터 비밀번호가 맞지 않습니다. (${_try}/3)" >&2
                if [ "$_try" -lt 3 ]; then
                    _ans=""
                    prompt_key _ans "   👉 무엇을 다시 입력할까요? 비밀번호(p) / 이메일(e) — 현재 이메일: ${_email}" p p e
                    if [ "$_ans" = "e" ]; then
                        _bw_login_ask_email || { _status="fail"; break; }
                    fi
                else
                    echo "   ℹ️  3번 모두 맞지 않았습니다. Bitwarden 이메일(${_email})과 마스터 비밀번호를 확인한 뒤 다시 진행하세요." >&2
                fi
                ;;
            *"Email address is invalid"*)
                echo "❌ 이메일 주소가 올바르지 않습니다: ${_email}" >&2; _status="fail"; break ;;
            *)
                echo "❌ Bitwarden 로그인 실패: ${_err:-알 수 없는 오류} (${_try}/3)" >&2 ;;
        esac
    done
    unset -f _bw_login_ask_email

    # 3) 2단계 인증 / 새 기기 확인 코드 (bw 가 직접 묻도록 대화형 실행)
    if [ "$_status" = "code" ]; then
        echo "🔢 2단계 인증 또는 새 기기 확인 코드가 필요합니다."
        echo "   (메일로 받는 코드는 시도할 때마다 새로 발송되니 가장 최근 메일의 코드를 입력하세요)"
        for _try in 1 2 3; do
            _out=$(BW_PASSWORD="$_pw" bw login "$_email" --passwordenv BW_PASSWORD --raw </dev/tty) && { _status="ok"; break; }
            _status="code_fail"
            [ "$_try" -lt 3 ] && echo "❌ 코드가 맞지 않거나 취소되었습니다. 다시 시도합니다. (${_try}/3)" >&2
        done
    fi
    _pw=""
    unset _pw
    rm -f "$_errf"

    if [ "$_status" != "ok" ] || [ -z "$_out" ]; then
        echo "❌ Bitwarden 로그인에 실패했습니다." >&2
        return 1
    fi
    BW_SESSION="$_out"
    export BW_SESSION
    (umask 077; echo "$BW_SESSION" > "$_BW_SESSION_FILE")
    chmod 600 "$_BW_SESSION_FILE" 2>/dev/null || true
    echo "✅ Bitwarden 로그인 완료 (${_email})"
    return 0
}

# Bitwarden PAT 로 GitHub 로그인 일괄 설정: git user.name/email + ~/.git-credentials + gh CLI
# 인수: $1 = Bitwarden 아이템 이름 (선택, 기본값: $BW_DEFAULT_PAT_ITEM)
#        생략하면 항목 이름을 물어봅니다(엔터 = 기본값 — 예전 프로젝트 clone 흐름 bw_git_clone_interactive 와 같은 질문).
#        항목을 못 찾거나 PAT 필드가 없으면 3번까지 다시 입력받습니다.
# 반환: 0 = 설정 완료 또는 이미 로그인됨, 1 = 실패(Bitwarden 미설치·로그인 실패·항목 없음 등)
bw_setup_github_auth() {
    local _item_arg="${1:-}" _item="${1:-$BW_DEFAULT_PAT_ITEM}" _host="github.com"

    # 이미 로그인되어 있으면 Bitwarden 잠금 해제(마스터 비밀번호 입력) 없이 끝냅니다.
    if bw_git_credentials_exist "$_host" && bw_gh_auth_ok "$_host"; then
        echo "ℹ️  GitHub 로그인이 이미 설정되어 있습니다. (git 자격 증명$(command -v gh >/dev/null 2>&1 && echo ' + gh CLI'))"
        return 0
    fi

    if ! command -v bw >/dev/null 2>&1; then
        echo "❌ Bitwarden CLI(bw)를 찾을 수 없어 GitHub 로그인을 자동 설정할 수 없습니다." >&2
        return 1
    fi

    # Bitwarden 에 아직 로그인하지 않은 PC(첫 설치)라면 그 자리에서 로그인합니다.
    # 로그인은 세션 키만 받아 잠금 해제(_bw_do_unlock)와 같은 방식으로 세션 파일(소유자 전용)에 저장해
    # 비밀번호를 두 번 묻지 않습니다.
    # (예전에는 bw login --raw 한 번으로 이메일·비밀번호·2단계 인증을 함께 물어 하나라도 틀리면 바로 실패했지만,
    #  이제 bw_interactive_login 이 단계별로 3번까지 다시 입력받습니다)
    if bw status 2>/dev/null | grep -qE '"status": *"unauthenticated"'; then
        echo "🔑 Bitwarden 에 로그인되어 있지 않습니다. 이메일·마스터 비밀번호로 로그인합니다."
        bw_interactive_login || return 1
    fi
    bw_ensure_session || return 1

    local _parsed="" _user _email _pat="" _item_try
    for _item_try in 1 2 3; do
        # 항목 이름을 인수로 받지 않았으면 물어봄 (엔터 = 기본값 / 무인 실행은 기본값)
        if [ -z "$_item_arg" ]; then
            prompt_text _item "🔑 GitHub 계정 정보가 있는 Bitwarden 항목 이름" "$BW_DEFAULT_PAT_ITEM"
            _item="${_item:-$BW_DEFAULT_PAT_ITEM}"
        fi
        echo "⏳ Bitwarden에서 '${_item}' 계정 정보 조회 중..."
        _pat=""
        if _parsed=$(bw_find_item_live "$_item"); then
            _pat=$(printf "%s" "$_parsed" | cut -f4)   # 사용자 지정 필드 "PAT" 값
            [ -n "$_pat" ] && break
            echo "❌ '${_item}' 항목에 라벨이 \"PAT\"인 사용자 지정 필드를 찾을 수 없습니다." >&2
        fi
        # 인수로 받은 이름이거나 무인 실행이면 다시 물어도 같으므로 바로 실패
        if [ -n "$_item_arg" ] || dt2_is_noninteractive 2>/dev/null; then
            return 1
        fi
        [ "$_item_try" -lt 3 ] && echo "   항목 이름을 확인해 다시 입력해 주세요. (${_item_try}/3)" >&2
    done
    [ -n "$_pat" ] || return 1
    _user=$(printf "%s" "$_parsed" | cut -f1 | tr -d '@')
    _email=$(printf "%s" "$_parsed" | cut -f2)
    echo "✅ GitHub 계정 확인: $_user ($_email)"

    bw_setup_git_config "$_user" "$_email"
    echo ""
    bw_save_git_credentials "https://${_host}" "$_pat" "$_user"
    # git user.name 이 이미 있어 bw_setup_git_config 가 건너뛴 경우에도 자격 증명 저장소를 쓰도록 보장
    if [ -z "$(git config --global --get credential.helper 2>/dev/null)" ]; then
        git config --global credential.helper store
    fi
    bw_setup_gh_auth "$_pat" "$_host"
    return 0
}

# ── Bitwarden PAT 인증으로 git clone 수행 ─────────────────────────────────────
# 인수:
#   $1 = 클론할 저장소 URL (필수)
#   $2 = 로컬 대상 경로 (필수)
#   $3 = Bitwarden 아이템 이름 (선택, 기본값: $BW_DEFAULT_PAT_ITEM)
#        → username/email 은 bw_find_item_by_name 의 user.name / user.email 필드
#          우선순위 규칙을 따름. 사용자 지정 필드(라벨 "PAT") = PAT 토큰
#        → 이름이 정확히 일치하는 항목이 없거나 2개 이상이면 에러 처리됩니다.
# 반환: 0 = 성공, 1 = 실패
# 전제: bw_ensure_session 이 선행 호출되어 BW_SESSION 이 유효한 상태여야 함
bw_git_clone() {
    local _REPO_URL="$1"
    local _TARGET_DIR="$2"
    local _BW_ITEM="${3:-$BW_DEFAULT_PAT_ITEM}"

    if [ -z "$_REPO_URL" ] || [ -z "$_TARGET_DIR" ]; then
        echo "❌ bw_git_clone: repo_url 과 target_dir 은 필수입니다." >&2
        return 1
    fi

    # 세션 유효 확인
    if [ -z "${BW_SESSION:-}" ]; then
        echo "❌ bw_git_clone: BW_SESSION 이 없습니다. bw_ensure_session 을 먼저 호출하세요." >&2
        return 1
    fi

    echo "⏳ Bitwarden에서 '${_BW_ITEM}' 계정 정보 조회 중..."
    local _PARSED
    _PARSED=$(bw_find_item_live "$_BW_ITEM") || return 1

    # bw_find_item_by_name 반환 형식: username\temail\tpassword\tpat\tnotes
    local _GIT_USERNAME _GIT_EMAIL _GIT_PAT
    _GIT_USERNAME=$(printf "%s" "$_PARSED" | cut -f1)
    _GIT_EMAIL=$(printf "%s" "$_PARSED"    | cut -f2)
    _GIT_PAT=$(printf "%s" "$_PARSED"      | cut -f4)   # 사용자 지정 필드 "PAT" 값

    if [ -z "$_GIT_PAT" ]; then
        echo "❌ '${_BW_ITEM}' 항목에 라벨이 \"PAT\"인 사용자 지정 필드를 찾을 수 없습니다." >&2
        echo "   Bitwarden 항목의 '사용자 지정 필드'에 라벨 \"PAT\", 값=GitHub PAT 토큰을 추가해주세요." >&2
        return 1
    fi

    echo "✅ GitHub 계정 확인: $_GIT_USERNAME ($_GIT_EMAIL)"
    mkdir -p "$(dirname "$_TARGET_DIR")"

    local _ASKPASS
    _ASKPASS=$(mktemp /tmp/bw_askpass_XXXXXX.sh)
    chmod 700 "$_ASKPASS"
    cat > "$_ASKPASS" <<'ASKEOF'
#!/usr/bin/env bash
case "$1" in
  Username*) printf '%s\n' "$BW_ASKPASS_USER" ;;
  Password*) printf '%s\n' "$BW_ASKPASS_PAT"  ;;
esac
ASKEOF
    _bw_trap_save
    trap 'rm -f "$_ASKPASS"' EXIT INT TERM

    echo "🚀 저장소 클론 중: $_REPO_URL -> $_TARGET_DIR"
    BW_ASKPASS_USER="$_GIT_USERNAME" \
    BW_ASKPASS_PAT="$_GIT_PAT" \
    GIT_ASKPASS="$_ASKPASS" \
    GIT_TERMINAL_PROMPT=0 \
    git clone "$_REPO_URL" "$_TARGET_DIR"
    local _RC=$?
    rm -f "$_ASKPASS"
    _bw_trap_restore

    if [ $_RC -eq 0 ]; then
        echo "✅ 깃 클론 완료!"
        # git 전역 설정 (user.name / user.email) — 없는 경우에만 대화형 설정
        local _bw_cfg_name
        _bw_cfg_name=$(echo "$_GIT_USERNAME" | tr -d '@')
        bw_setup_git_config "$_bw_cfg_name" "$_GIT_EMAIL"
        echo ""
        # PAT 저장 여부 질의 (credential store)
        bw_save_git_credentials "$_REPO_URL" "$_GIT_PAT" "$_bw_cfg_name"
        # GitHub CLI(gh) 도 같은 PAT 로 로그인 (gh 미설치·이미 로그인이면 건너뜀)
        bw_setup_gh_auth "$_GIT_PAT" "$(echo "$_REPO_URL" | sed -E 's|^https?://||' | cut -d'/' -f1)"
    else
        echo "❌ 깃 클론 실패 (종료 코드: $_RC)" >&2
    fi
    return $_RC
}

# ── bw_git_clone 대화형 래퍼: 항목 이름을 사용자에게 프롬프트로 입력받아 clone ──
# 인수:
#   $1 = 클론할 저장소 URL (필수)
#   $2 = 로컬 대상 경로 (필수)
# 동작:
#   $BW_DEFAULT_PAT_ITEM 을 기본값으로 보여주고, 사용자 입력을 받아(엔터=기본값)
#   bw_git_clone 을 호출합니다. 여러 GitHub 계정을 항목별로 나눠 관리할 때
#   호출부마다 프롬프트 코드를 복붙하지 않도록 이 함수 하나로 모았습니다.
# 반환: bw_git_clone 과 동일
# 전제: bw_ensure_session 이 선행 호출되어 BW_SESSION 이 유효한 상태여야 함
bw_git_clone_interactive() {
    local _REPO_URL="$1"
    local _TARGET_DIR="$2"
    local _BW_DEFAULT_ITEM="${BW_DEFAULT_PAT_ITEM:-github.com-main}"
    local _BW_ITEM_NAME

    prompt_text _BW_ITEM_NAME "🔑 Bitwarden 'GitHub' 항목 이름" "$_BW_DEFAULT_ITEM"
    _BW_ITEM_NAME="${_BW_ITEM_NAME:-$_BW_DEFAULT_ITEM}"

    bw_git_clone "$_REPO_URL" "$_TARGET_DIR" "$_BW_ITEM_NAME"
}

# ── 저장된 GitHub 로그인으로 clone, 실패 시 Bitwarden PAT 로 폴백 ──────────────────
# 설치 스크립트(3.install-cli-tools.sh)가 GitHub 로그인을 미리 설정해 두었으면 PAT 질문 없이 바로 clone 하고,
# 로그인이 없거나(새 PC·설치 시 건너뜀) 저장된 PAT 가 만료되어 인증에 실패하면 기존 bw_git_clone_interactive 로 폴백합니다.
# 인수: $1 = 저장소 URL, $2 = 로컬 대상 경로
# 전제: 폴백 시 bw_ensure_session 이 선행 호출되어 BW_SESSION 이 유효해야 함
bw_git_clone_with_fallback() {
    local _REPO_URL="$1" _TARGET_DIR="$2" _host
    _host=$(echo "$_REPO_URL" | sed -E 's|^https?://||' | cut -d'/' -f1)
    if bw_git_credentials_exist "$_host"; then
        echo "🚀 저장된 GitHub 로그인으로 저장소 클론 중: $_REPO_URL -> $_TARGET_DIR"
        mkdir -p "$(dirname "$_TARGET_DIR")"
        # GIT_TERMINAL_PROMPT=0: 저장된 PAT 가 만료됐으면 사용자명/비밀번호를 묻지 않고 바로 실패 → 폴백
        if GIT_TERMINAL_PROMPT=0 git clone "$_REPO_URL" "$_TARGET_DIR"; then
            echo "✅ 깃 클론 완료!"
            return 0
        fi
        echo "⚠️  저장된 GitHub 로그인으로 클론하지 못했습니다(PAT 만료·권한 부족 등). Bitwarden PAT 로 다시 시도합니다."
    else
        echo "ℹ️  저장된 GitHub 로그인이 없어 Bitwarden PAT 로 클론합니다."
    fi
    bw_git_clone_interactive "$_REPO_URL" "$_TARGET_DIR"
}

# ── Bitwarden 서버 항목 JSON 파싱 공용 헬퍼 ─────────────────────────────────────
# 복수 폴더 청크(---ITEM_SPLIT--- 구분) 데이터를 파이썬으로 안전하게 파싱하여 fzf 형식으로 출력
# 출력 형식: [표시]\t[itemID]\t[username]\t[uri]\t[has_key]
bw_parse_server_items() {
    local raw_data="$1"
    [ -z "$raw_data" ] && return 0

    python3 -c '
import sys, json, re

raw_all = sys.stdin.read()
chunks = raw_all.split("---ITEM_SPLIT---")

all_items = []
for chunk in chunks:
    chunk = chunk.strip()
    if not chunk:
        continue
    start_idx = chunk.find("[")
    end_idx = chunk.rfind("]")
    if start_idx != -1 and end_idx != -1 and start_idx < end_idx:
        try:
            items = json.loads(chunk[start_idx:end_idx+1], strict=False)
            if isinstance(items, list):
                all_items.extend(items)
        except Exception:
            pass

if not all_items:
    sys.exit(0)

for item in all_items:
    if not isinstance(item, dict):
        continue
    name     = item.get("name", "이름없음")
    item_id  = item.get("id", "")

    login = item.get("login")
    if not isinstance(login, dict):
        login = {}

    username = login.get("username") or ""
    uris     = login.get("uris") or []

    raw_uri = ""
    if isinstance(uris, list) and len(uris) > 0:
        first_uri = uris[0]
        if isinstance(first_uri, dict):
            raw_uri = first_uri.get("uri") or ""

    notes = item.get("notes") or ""
    if not isinstance(notes, str):
        notes = ""

    clean_uri = re.sub(r"^[a-z]+://", "", raw_uri)
    has_key = "KEY" if re.search(r"BEGIN .* PRIVATE KEY", notes) else ""

    display = f"{name} | {username}@{clean_uri}"
    if has_key:
        display += " 🔑"

    print(f"{display}\t{item_id}\t{username}\t{clean_uri}\t{has_key}")
' <<< "$raw_data"
}

