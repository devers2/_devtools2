#!/usr/bin/env bash
# ==============================================================================
# bw-lib: Bitwarden 인증 / 세션 공유 라이브러리
# ==============================================================================
# 사용법: source "$(dirname "${BASH_SOURCE[0]}")/bw-lib"
#          또는 source "$DEVTOOLS2/scripts/fzf/bw-lib"
#
# 이 파일을 source 하면 아래 함수들이 현재 셸에 로드됩니다.
#   bw_ensure_session            → BW_SESSION 을 보장 (없으면 unlock 수행)
#   bw_get_folder_ids            → 폴더명으로 일치하는 모든 폴더 ID 목록 반환
#   bw_get_items_by_folder_name  → 폴더명으로 아이템 JSON 청크 목록 반환
#   bw_find_item_by_name         → 이름이 정확히 일치하는 아이템 JSON 반환
#                                  (일치 항목이 없으면 빈 출력, 2개 이상이면 종료코드 3)
#   bw_find_item_live            → 아이템 이름으로 실시간 조회(bw list items) + 파싱을 한 번에 수행
#                                  (세션 만료/미발견/중복(2개 이상) 시 에러 메시지 출력,
#                                   조용히 실패시키려면 2>/dev/null)
#                                  출력: username\temail\tpassword\tpat\tnotes (탭 구분)
#                                    - username: 아이템의 사용자 지정 필드 "user.name" 값이 있으면 그 값,
#                                                없으면 login.username(이메일)의 @ 앞부분
#                                    - email   : 아이템의 사용자 지정 필드 "user.email" 값이 있으면 그 값,
#                                                없으면 login.username(이메일) 그대로
#   bw_get_fields                → 아이템 이름 + 사용자 지정 필드 라벨 목록으로 값들을 한 번에 조회
#                                  사용법: bw_get_fields "<아이템명>" "필드1" "필드2" ...
#                                  → 탭 구분으로 요청 순서대로 반환 (없으면 빈 문자열)
#   bw_setup_git_config          → git 전역 설정 (user.name / user.email) — 없는 경우에만 대화형 설정
#                                  사용법: bw_setup_git_config <default_name> <default_email>
#   bw_save_git_credentials      → PAT 를 ~/.git-credentials 에 저장 (사용자 확인 후)
#                                  사용법: bw_save_git_credentials <repo_url> <pat> <username>
#   bw_git_clone                 → Bitwarden PAT 인증으로 git clone 수행
#                                  (성공 시 bw_setup_git_config + bw_save_git_credentials 자동 호출)
#                                  사용법: bw_git_clone <repo_url> <target_dir> [bw_item_name]
#                                  bw_item_name 기본값: $BW_DEFAULT_PAT_ITEM (기본 "github.com-main")
#   bw_git_clone_interactive     → bw_git_clone 대화형 래퍼: Bitwarden 항목 이름을 사용자에게
#                                  프롬프트로 입력받은 뒤 bw_git_clone 호출 (기본값 제안, 엔터 시 기본값 사용)
#                                  사용법: bw_git_clone_interactive <repo_url> <target_dir>
#                                  → 개별 프로젝트 설정 스크립트/command-palette 등에서 항목명을
#                                    직접 프롬프트하고 싶을 때 이 함수 하나만 호출하면 됩니다
#                                    (프롬프트 문구/로직을 바꿀 일이 생기면 여기 한 곳만 수정)
#
# 공통 상수:
#   BW_DEFAULT_PAT_ITEM          → PAT 인증에 사용할 Bitwarden 아이템 이름의 공통 기본값
#                                  ("github.com-main"). bw_git_clone / setup_gpr_gradle_properties
#                                  (common-setup.sh) 등 PAT 인증 관련 함수들이 공유해서 사용합니다.
#                                  다른 아이템을 쓰려면 함수 호출 시 인수로 이름을 넘기면 됩니다.
#                                  해당 이름과 정확히 일치하는 아이템이 없거나 2개 이상이면 에러 처리됩니다.
# ==============================================================================

# ── PAT 인증 관련 함수들이 공유하는 기본 Bitwarden 아이템 이름 ─────────────────
BW_DEFAULT_PAT_ITEM="${BW_DEFAULT_PAT_ITEM:-github.com-main}"

# ── 세션 파일 경로 결정 ────────────────────────────────────────────────────────
_BW_HOME_DIR="${HOME:-$USERPROFILE}"
_BW_DEVTOOLS2_DIR="${_BW_HOME_DIR}/.devtools2"
mkdir -p "$_BW_DEVTOOLS2_DIR"

if [ -d "/dev/shm" ]; then
    _BW_SESSION_FILE="/dev/shm/bw_session_${UID:-$(id -u)}"
else
    _BW_SESSION_FILE="${_BW_DEVTOOLS2_DIR}/bw_session"
fi

# ── bw vault 잠금 해제 수행 ───────────────────────────────────────────────────
_bw_do_unlock() {
    local _MASTER_PASS
    echo ""
    read -rsp "🔐 Bitwarden 마스터 비밀번호 입력 (보안 마스킹): 🔒 " _MASTER_PASS
    echo ""

    if [ -z "$_MASTER_PASS" ]; then
        echo "❌ 비밀번호가 입력되지 않았습니다."
        return 1
    fi

    echo "🔓 Bitwarden vault 잠금 해제 중..."
    local _UNLOCK_OUTPUT
    # ⚠️ 비밀번호를 `bw unlock "$_MASTER_PASS"`처럼 커맨드라인 인자로 넘기면 실행되는
    # 짧은 순간 동안 ps/proc/cmdline을 통해 같은 시스템의 다른 사용자에게 노출될 수 있습니다.
    # Bitwarden 공식 문서가 권장하는 --passwordenv로 환경변수를 통해서만 전달합니다.
    export BW_PASSWORD="$_MASTER_PASS"
    unset _MASTER_PASS
    _UNLOCK_OUTPUT=$(bw unlock --passwordenv BW_PASSWORD 2>&1)
    unset BW_PASSWORD

    BW_SESSION=$(echo "$_UNLOCK_OUTPUT" | grep -oP '(?<=export BW_SESSION=")[^"]+' | head -1)

    if [ -z "$BW_SESSION" ]; then
        echo "❌ 잠금 해제에 실패했습니다. 마스터 비밀번호를 확인해주세요."
        return 1
    fi

    echo "$BW_SESSION" > "$_BW_SESSION_FILE"
    chmod 600 "$_BW_SESSION_FILE"
    export BW_SESSION

    if [ -d "/dev/shm" ]; then
        echo "✅ 잠금 해제 완료. (세션키가 메모리(tmpfs)에 저장되었습니다)"
    else
        echo "✅ 잠금 해제 완료. (세션이 ${_BW_SESSION_FILE} 에 저장되었습니다)"
    fi
}

# ── BW_SESSION 보장 (핵심 진입점) ─────────────────────────────────────────────
# 호출 후 BW_SESSION 이 유효한 상태를 보장합니다.
# 반환: 0 = 성공, 1 = 실패
bw_ensure_session() {
    # bw CLI 존재 확인
    if ! command -v bw &>/dev/null; then
        echo "❌ Bitwarden CLI(bw)를 찾을 수 없습니다."
        echo "   설치 방법: https://bitwarden.com/help/cli/"
        return 1
    fi

    # 저장된 세션키 로드 (환경변수 우선, 없으면 파일)
    if [ -z "${BW_SESSION:-}" ] && [ -f "$_BW_SESSION_FILE" ]; then
        BW_SESSION=$(cat "$_BW_SESSION_FILE")
        export BW_SESSION
    fi

    # bw 상태 확인
    local _STATUS_JSON _STATUS
    _STATUS_JSON=$(bw status 2>/dev/null)
    _STATUS=$(echo "$_STATUS_JSON" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('status', 'unknown'))
except:
    print('unknown')
")

    case "$_STATUS" in
    unauthenticated)
        echo "🔑 Bitwarden에 로그인되어 있지 않습니다."
        echo "   아래 명령어로 먼저 로그인해주세요:"
        echo ""
        echo "   bw login"
        echo ""
        return 1
        ;;
    locked)
        _bw_do_unlock || return 1
        ;;
    unlocked)
        if [ -z "${BW_SESSION:-}" ]; then
            _bw_do_unlock || return 1
        fi
        ;;
    *)
        echo "❌ Bitwarden 상태를 확인할 수 없습니다. (status: $_STATUS)"
        return 1
        ;;
    esac

    return 0
}

# ── 폴더명으로 일치하는 폴더 ID 목록 반환 (공백 구분) ─────────────────────────
# 인수: $1 = 폴더명 (정확 일치)
# 출력: 폴더 ID 목록 (공백 구분) → 일치 없으면 빈 문자열
bw_get_folder_ids() {
    local _FOLDER_NAME="$1"
    local _FOLDERS_JSON

    _FOLDERS_JSON=$(bw list folders --session "$BW_SESSION" </dev/null 2>&1)

    if echo "$_FOLDERS_JSON" | grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE"; then
        echo "❌ Bitwarden 세션이 만료되었습니다." >&2
        rm -f "$_BW_SESSION_FILE"
        return 1
    fi

    # ⚠️ 폴더명을 파이썬 소스에 문자열로 직접 이어붙이지 않고 sys.argv로 전달합니다.
    # (bw_find_item_by_name / bw_get_fields와 동일한 안전한 패턴 — 폴더명에 따옴표 등
    # 특수문자가 섞여 들어와도 파이썬 코드로 해석되지 않습니다.)
    echo "$_FOLDERS_JSON" | python3 -c "
import sys, json

try:
    raw = sys.stdin.read()
    start = raw.find('[')
    end = raw.rfind(']')
    if start != -1 and end != -1 and start < end:
        folders = json.loads(raw[start:end+1], strict=False)
        target = sys.argv[1].strip()
        matched = [f.get('id','') for f in folders if isinstance(f, dict) and str(f.get('name','')).strip() == target and f.get('id')]
        print(' '.join(matched))
except Exception:
    pass
" "$_FOLDER_NAME" 2>/dev/null
}

# ── 폴더명으로 아이템 전체 조회 후 RAW_ITEMS_LIST 반환 ────────────────────────
# 인수: $1 = 폴더명
# 출력: ---ITEM_SPLIT--- 로 구분된 JSON 청크 문자열
# 반환: 0 = 성공, 1 = 세션 오류
bw_get_items_by_folder_name() {
    local _FOLDER_NAME="$1"
    local _FOLDER_IDS _ITEMS _RAW=""

    _FOLDER_IDS=$(bw_get_folder_ids "$_FOLDER_NAME") || return 1

    if [ -z "$_FOLDER_IDS" ]; then
        return 0
    fi

    for _FID in $_FOLDER_IDS; do
        _ITEMS=$(bw list items --folderid "$_FID" --session "$BW_SESSION" </dev/null 2>&1)
        if echo "$_ITEMS" | grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE"; then
            echo "❌ Bitwarden 세션이 만료되었습니다." >&2
            rm -f "$_BW_SESSION_FILE"
            return 1
        fi
        if [ -n "$_ITEMS" ] && [ "$_ITEMS" != "[]" ]; then
            _RAW="${_RAW}${_ITEMS}"$'\n---ITEM_SPLIT---\n'
        fi
    done

    printf "%s" "$_RAW"
}

# ── 이름이 정확히 일치하는 아이템의 필드를 추출 ───────────────────────────────
# 인수: $1 = RAW_ITEMS_LIST (---ITEM_SPLIT--- 구분 문자열)
#       $2 = 찾을 아이템 이름 (정확 일치)
# 출력: username\temail\tpassword\tpat\tnotes (탭 구분)
#   username: 사용자 지정 필드 "user.name" 값이 있으면 그 값, 없으면 login.username(이메일)의 @ 앞부분
#   email   : 사용자 지정 필드 "user.email" 값이 있으면 그 값, 없으면 login.username(이메일) 그대로
#   pat     : 사용자 지정 필드 중 라벨이 "PAT"인 필드의 값
#   (필드 라벨 매칭은 대소문자/앞뒤공백 무관 — 계정마다 다른 Bitwarden 볼트에서도 라벨만 맞으면 동작)
# 반환: 0 = 성공(일치 0개 또는 1개), 3 = 이름이 정확히 일치하는 아이템이 2개 이상(중복)
#   일치 항목이 없으면 빈 출력 + 종료코드 0
bw_find_item_by_name() {
    local _RAW="$1"
    local _TARGET_NAME="$2"

    # 임시 파이썬 스크립트로 파싱 (stdin 충돌 방지)
    local _PY
    _PY=$(mktemp /tmp/bw_find_XXXXXX.py)
    cat > "$_PY" <<'PYEOF'
import sys, json

raw_all = sys.stdin.read()
target_name = sys.argv[1] if len(sys.argv) > 1 else ''

matches = []
chunks = raw_all.split('---ITEM_SPLIT---')
for chunk in chunks:
    chunk = chunk.strip()
    if not chunk:
        continue
    start = chunk.find('[')
    end = chunk.rfind(']')
    if start == -1 or end == -1 or start >= end:
        continue
    try:
        items = json.loads(chunk[start:end+1], strict=False)
    except Exception:
        continue
    for item in items:
        if isinstance(item, dict) and str(item.get('name', '')).strip() == target_name:
            matches.append(item)

if len(matches) > 1:
    sys.exit(3)

if len(matches) == 1:
    item = matches[0]
    login = item.get('login') or {}
    login_username = login.get('username') or ''
    password = login.get('password') or ''

    field_map = {}
    for f in (item.get('fields') or []):
        if isinstance(f, dict):
            key = str(f.get('name') or '').strip().lower()
            field_map[key] = f.get('value') or ''

    pat = field_map.get('pat', '')
    custom_username = field_map.get('user.name', '')
    custom_email = field_map.get('user.email', '')

    username = custom_username if custom_username else login_username.split('@')[0]
    email = custom_email if custom_email else login_username

    notes = str(item.get('notes') or '')
    print(f"{username}\t{email}\t{password}\t{pat}\t{notes}")
PYEOF

    printf "%s" "$_RAW" | python3 "$_PY" "$_TARGET_NAME"
    local _RC=$?
    rm -f "$_PY"
    return $_RC
}

# ── 아이템 이름으로 실시간 조회 + 필드 파싱까지 한 번에 수행 ───────────────────
# (bw list items --search → 세션 만료 감지 → bw_find_item_by_name 파싱을 묶은 상위 래퍼.
#  bw_git_clone / setup_gpr_gradle_properties(common-setup.sh)가 각자 이 글루 코드를
#  복붙해 쓰고 있던 걸 한 곳으로 모음)
# 인수: $1 = 찾을 아이템 이름 (정확 일치)
# 출력: username\temail\tpassword\tpat\tnotes (탭 구분, bw_find_item_by_name과 동일 포맷)
# 반환: 0 = 성공, 1 = 세션 만료 / 아이템 없음 / 아이템 2개 이상(중복)
# 전제: BW_SESSION 이 유효한 상태여야 함
#   실패 시 원인(세션 만료 / 미발견 / 중복)에 맞는 에러 메시지를 stderr에 출력합니다.
#   조용히 실패시키고 싶으면 호출부에서 2>/dev/null 로 감싸세요 (예: common-setup.sh의
#   선택적 조회처럼 "없으면 그냥 넘어가는" 흐름).
# 내부 헬퍼: 아이템 이름으로 실시간 조회 + 세션 만료 감지까지 수행 (Raw JSON 반환)
# bw_find_item_live / bw_get_fields 가 공유하는 글루 코드
# 반환: 0 = 성공, 1 = 세션 만료
_bw_search_raw() {
    local _ITEM_NAME="$1"
    local _RAW
    _RAW=$(bw list items --search "$_ITEM_NAME" --session "$BW_SESSION" </dev/null 2>&1)
    if echo "$_RAW" | grep -qi "not logged in\|Vault is locked\|invalid session\|ERR_USE_AFTER_CLOSE"; then
        echo "❌ Bitwarden 세션이 만료되었습니다. 다시 실행해주세요." >&2
        rm -f "$_BW_SESSION_FILE"
        return 1
    fi
    printf "%s" "$_RAW"
}

bw_find_item_live() {
    local _ITEM_NAME="$1"
    local _ALL_ITEMS_RAW
    _ALL_ITEMS_RAW=$(_bw_search_raw "$_ITEM_NAME") || return 1
    local _PARSED
    _PARSED=$(bw_find_item_by_name "${_ALL_ITEMS_RAW}"$'\n---ITEM_SPLIT---\n' "$_ITEM_NAME")
    local _RC=$?
    if [ $_RC -eq 3 ]; then
        echo "❌ Bitwarden에서 '${_ITEM_NAME}' 이름과 정확히 일치하는 항목이 2개 이상 있습니다." >&2
        echo "   항목 이름을 고유하게 정리한 뒤 다시 시도해주세요." >&2
        return 1
    fi
    if [ -z "$_PARSED" ]; then
        echo "❌ Bitwarden에서 '${_ITEM_NAME}' 항목을 찾을 수 없습니다." >&2
        return 1
    fi
    printf "%s" "$_PARSED"
}

# ── 아이템 이름 + 사용자 지정 필드 라벨 목록으로 값들을 한 번에 조회 ───────────
# login.username/password/totp 처럼 고정된 필드가 아니라, 아이템의 "사용자 지정
# 필드"(fields) 중 원하는 라벨들의 값만 골라 가져올 때 사용합니다
# (Maven Central Portal의 centralUsername/centralPassword, GPG Signing의
#  signing.keyId/signing.password/signing.secretKeyRingBase64 등 임의 필드 조합).
# 인수: $1 = 아이템 이름 (정확 일치), $2.. = 조회할 필드 라벨 목록 (대소문자/공백 무관 매칭)
# 출력: 요청한 순서대로 탭 구분 값 (아이템/필드가 없으면 해당 자리는 빈 문자열)
# 반환: 0 = 조회 성공(필드 값 존재 여부와 무관), 1 = 세션 만료
bw_get_fields() {
    local _ITEM_NAME="$1"
    shift
    local _FIELD_NAMES=("$@")

    local _RAW
    _RAW=$(_bw_search_raw "$_ITEM_NAME") || return 1

    local _PY
    _PY=$(mktemp /tmp/bw_fields_XXXXXX.py)
    cat > "$_PY" <<'PYEOF'
import sys, json

target_name = sys.argv[1]
field_names = sys.argv[2:]

raw = sys.stdin.read()
start = raw.find('[')
end = raw.rfind(']')

found = None
if start != -1 and end != -1 and start < end:
    try:
        items = json.loads(raw[start:end+1], strict=False)
        for item in items:
            if isinstance(item, dict) and str(item.get('name', '')).strip() == target_name:
                found = item
                break
    except Exception:
        pass

field_map = {}
if found:
    for f in (found.get('fields') or []):
        if isinstance(f, dict):
            key = str(f.get('name') or '').strip().lower()
            field_map[key] = f.get('value') or ''

values = [field_map.get(fn.strip().lower(), '') for fn in field_names]
print('\t'.join(values))
PYEOF

    printf "%s" "$_RAW" | python3 "$_PY" "$_ITEM_NAME" "${_FIELD_NAMES[@]}"
    rm -f "$_PY"
}

# ── git 전역 설정 (user.name / user.email) ────────────────────────────────────
# 인수:
#   $1 = 기본 user.name (Bitwarden 이메일의 @ 앞 부분, @ 제거된 값)
#   $2 = 기본 user.email (Bitwarden 이메일)
# 동작:
#   - user.name 또는 user.email 이 없는 경우에만 대화형 입력 실행
#   - Bitwarden 기본값을 제안하며 사용자 입력을 받음
#   - core.quotepath, credential.helper 도 함께 설정
# 반환: 0 = 성공 (설정 완료 또는 이미 존재)
bw_setup_git_config() {
    local _bw_default_name="${1:-}"
    local _bw_default_email="${2:-}"

    local _cur_git_name _cur_git_email
    _cur_git_name=$(git config --global user.name 2>/dev/null || echo "")
    _cur_git_email=$(git config --global user.email 2>/dev/null || echo "")

    if [ -n "$_cur_git_name" ] && [ -n "$_cur_git_email" ]; then
        echo "ℹ️  git 전역 설정이 이미 존재합니다:"
        echo "   user.name  = $_cur_git_name"
        echo "   user.email = $_cur_git_email"
        return 0
    fi

    echo "⚙️  git 전역 기본 설정(user.name / user.email)을 입력해주세요."
    echo "   [엔터]를 누르면 Bitwarden 기본값이 적용됩니다."
    echo ""
    read -rp "👤 user.name  [기본값: $_bw_default_name]: " _input_git_name
    read -rp "📧 user.email [기본값: $_bw_default_email]: " _input_git_email

    local _final_git_name _final_git_email
    _final_git_name="${_input_git_name:-$_bw_default_name}"
    _final_git_email="${_input_git_email:-$_bw_default_email}"
    # 이름에서 @ 문자 제거 (혹시 포함 시)
    _final_git_name=$(echo "$_final_git_name" | tr -d '@')

    git config --global user.name "$_final_git_name"
    git config --global user.email "$_final_git_email"
    git config --global core.quotepath false
    git config --global credential.helper store
    echo ""
    echo "✅ git config 전역 설정이 완료되었습니다:"
    echo "   user.name         = $_final_git_name"
    echo "   user.email        = $_final_git_email"
    echo "   core.quotepath    = false"
    echo "   credential.helper = store"
}

# ── git 인증 정보 저장 (~/.git-credentials) ──────────────────────────────────
# 인수:
#   $1 = 저장소 URL (host 추출에 사용, 예: https://github.com/user/repo.git)
#   $2 = PAT 토큰 (Bitwarden에서 가져온 값)
#   $3 = git user.name (@ 제거된 값, credential user 로 사용)
# 동작:
#   [기존 PAT 없음]  → 저장 여부 질의 후 저장
#   [기존 PAT 동일]  → 이미 최신임을 알리고 스킵
#   [기존 PAT 다름]  → 교체 여부 질의 후 교체
# 반환: 0 = 성공
bw_save_git_credentials() {
    local _repo_url="${1:-}"
    local _pat="${2:-}"
    local _username="${3:-}"

    if [ -z "$_pat" ]; then
        return 0
    fi

    local _cred_host
    _cred_host=$(echo "$_repo_url" | sed -E 's|^https?://||' | cut -d'/' -f1)

    # git config user.name 우선, 없으면 전달된 username 사용 (@ 제거 보장)
    local _cred_user
    _cred_user=$(git config --global user.name 2>/dev/null || echo "$_username")
    _cred_user=$(echo "$_cred_user" | tr -d '@')

    # ── 기존 credential 확인 ──────────────────────────────────────────────────
    local _existing_line=""
    if [ -f ~/.git-credentials ]; then
        _existing_line=$(grep "@${_cred_host}" ~/.git-credentials 2>/dev/null | head -1 || echo "")
    fi

    local _save_ans
    if [ -n "$_existing_line" ]; then
        # 기존 PAT 추출 (형식: https://user:PAT@host)
        local _existing_pat
        _existing_pat=$(echo "$_existing_line" | sed -E 's|^https?://[^:]+:([^@]+)@.*|\1|')

        if [ "$_existing_pat" = "$_pat" ]; then
            echo "ℹ️  ~/.git-credentials 에 동일한 PAT 가 이미 저장되어 있습니다. (host: $_cred_host)"
            return 0
        fi

        echo "⚠️  ~/.git-credentials 에 ${_cred_host} 의 기존 PAT 가 있으나 Bitwarden PAT 와 다릅니다."
        read -rp "🔄 기존 PAT 를 Bitwarden PAT 로 교체하시겠습니까? (y/N): " _save_ans
        _save_ans="${_save_ans:-n}"
    else
        read -rp "🔑 이후 git push/pull 시에도 자동 인증되도록 PAT 를 저장하시겠습니까? [Y/n]: " _save_ans
        _save_ans="${_save_ans:-y}"
    fi

    _save_ans=$(echo "$_save_ans" | tr '[:upper:]' '[:lower:]')
    if [[ "$_save_ans" != "y" ]]; then
        echo "ℹ️  인증 정보를 변경하지 않았습니다."
        return 0
    fi

    local _cred_line="https://${_cred_user}:${_pat}@${_cred_host}"
    local _tmp_creds
    _tmp_creds=$(mktemp)
    touch ~/.git-credentials
    chmod 600 ~/.git-credentials
    grep -v "@${_cred_host}" ~/.git-credentials > "$_tmp_creds" 2>/dev/null || true
    echo "$_cred_line" >> "$_tmp_creds"
    mv "$_tmp_creds" ~/.git-credentials
    echo "✅ PAT 가 ~/.git-credentials 에 저장되었습니다. (host: $_cred_host)"
}

# ── Bitwarden PAT 인증으로 git clone 수행 ─────────────────────────────────────
# 인수:
#   $1 = 클론할 저장소 URL (필수)
#   $2 = 로컬 대상 경로 (필수)
#   $3 = Bitwarden 아이템 이름 (선택, 기본값: $BW_DEFAULT_PAT_ITEM)
#        → username/email 은 bw_find_item_by_name 의 user.name / user.email 필드
#          우선순위 규칙을 따름. 사용자 지정 필드(라벨 "PAT") = PAT 토큰
#        → 이름이 정확히 일치하는 항목이 없거나 2개 이상이면 에러 처리됩니다.
# 반환: 0 = 성공, 1 = 실패
# 전제: bw_ensure_session 이 선행 호출되어 BW_SESSION 이 유효한 상태여야 함
bw_git_clone() {
    local _REPO_URL="$1"
    local _TARGET_DIR="$2"
    local _BW_ITEM="${3:-$BW_DEFAULT_PAT_ITEM}"

    if [ -z "$_REPO_URL" ] || [ -z "$_TARGET_DIR" ]; then
        echo "❌ bw_git_clone: repo_url 과 target_dir 은 필수입니다." >&2
        return 1
    fi

    # 세션 유효 확인
    if [ -z "${BW_SESSION:-}" ]; then
        echo "❌ bw_git_clone: BW_SESSION 이 없습니다. bw_ensure_session 을 먼저 호출하세요." >&2
        return 1
    fi

    echo "⏳ Bitwarden에서 '${_BW_ITEM}' 계정 정보 조회 중..."
    local _PARSED
    _PARSED=$(bw_find_item_live "$_BW_ITEM") || return 1

    # bw_find_item_by_name 반환 형식: username\temail\tpassword\tpat\tnotes
    local _GIT_USERNAME _GIT_EMAIL _GIT_PAT
    _GIT_USERNAME=$(printf "%s" "$_PARSED" | cut -f1)
    _GIT_EMAIL=$(printf "%s" "$_PARSED"    | cut -f2)
    _GIT_PAT=$(printf "%s" "$_PARSED"      | cut -f4)   # 사용자 지정 필드 "PAT" 값

    if [ -z "$_GIT_PAT" ]; then
        echo "❌ '${_BW_ITEM}' 항목에 라벨이 \"PAT\"인 사용자 지정 필드를 찾을 수 없습니다." >&2
        echo "   Bitwarden 항목의 '사용자 지정 필드'에 라벨 \"PAT\", 값=GitHub PAT 토큰을 추가해주세요." >&2
        return 1
    fi

    echo "✅ GitHub 계정 확인: $_GIT_USERNAME ($_GIT_EMAIL)"
    mkdir -p "$(dirname "$_TARGET_DIR")"

    local _ASKPASS
    _ASKPASS=$(mktemp /tmp/bw_askpass_XXXXXX.sh)
    chmod 700 "$_ASKPASS"
    cat > "$_ASKPASS" <<ASKEOF
#!/usr/bin/env bash
case "\$1" in
  Username*) echo "${_GIT_USERNAME}" ;;
  Password*) echo "${_GIT_PAT}"      ;;
esac
ASKEOF

    echo "🚀 저장소 클론 중: $_REPO_URL -> $_TARGET_DIR"
    GIT_ASKPASS="$_ASKPASS" \
    GIT_TERMINAL_PROMPT=0 \
    git clone "$_REPO_URL" "$_TARGET_DIR"
    local _RC=$?
    rm -f "$_ASKPASS"

    if [ $_RC -eq 0 ]; then
        echo "✅ 깃 클론 완료!"
        # git 전역 설정 (user.name / user.email) — 없는 경우에만 대화형 설정
        local _bw_cfg_name
        _bw_cfg_name=$(echo "$_GIT_USERNAME" | tr -d '@')
        bw_setup_git_config "$_bw_cfg_name" "$_GIT_EMAIL"
        echo ""
        # PAT 저장 여부 질의 (credential store)
        bw_save_git_credentials "$_REPO_URL" "$_GIT_PAT" "$_bw_cfg_name"
    else
        echo "❌ 깃 클론 실패 (종료 코드: $_RC)" >&2
    fi
    return $_RC
}

# ── bw_git_clone 대화형 래퍼: 항목 이름을 사용자에게 프롬프트로 입력받아 clone ──
# 인수:
#   $1 = 클론할 저장소 URL (필수)
#   $2 = 로컬 대상 경로 (필수)
# 동작:
#   $BW_DEFAULT_PAT_ITEM 을 기본값으로 보여주고, 사용자 입력을 받아(엔터=기본값)
#   bw_git_clone 을 호출합니다. 여러 GitHub 계정을 항목별로 나눠 관리할 때
#   호출부마다 프롬프트 코드를 복붙하지 않도록 이 함수 하나로 모았습니다.
# 반환: bw_git_clone 과 동일
# 전제: bw_ensure_session 이 선행 호출되어 BW_SESSION 이 유효한 상태여야 함
bw_git_clone_interactive() {
    local _REPO_URL="$1"
    local _TARGET_DIR="$2"
    local _BW_DEFAULT_ITEM="${BW_DEFAULT_PAT_ITEM:-github.com-main}"
    local _BW_ITEM_NAME

    read -rp "🔑 Bitwarden 항목 이름 [기본값: ${_BW_DEFAULT_ITEM}]: " _BW_ITEM_NAME
    _BW_ITEM_NAME="${_BW_ITEM_NAME:-$_BW_DEFAULT_ITEM}"

    bw_git_clone "$_REPO_URL" "$_TARGET_DIR" "$_BW_ITEM_NAME"
}
