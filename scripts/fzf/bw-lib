#!/usr/bin/env bash
# ==============================================================================
# bw-lib: Bitwarden 인증 / 세션 공유 라이브러리
# ==============================================================================
# 사용법: source "$(dirname "${BASH_SOURCE[0]}")/bw-lib"
#          또는 source "$DEVTOOLS2/scripts/fzf/bw-lib"
#
# 이 파일을 source 하면 아래 함수들이 현재 셸에 로드됩니다.
#   bw_ensure_session            → BW_SESSION 을 보장 (없으면 unlock 수행)
#   bw_get_folder_ids            → 폴더명으로 일치하는 모든 폴더 ID 목록 반환
#   bw_get_items_by_folder_name  → 폴더명으로 아이템 JSON 청크 목록 반환
#   bw_find_item_by_name         → 이름이 정확히 일치하는 아이템 JSON 반환
#                                  (일치 항목이 없으면 빈 출력, 2개 이상이면 종료코드 3)
#   bw_find_item_live            → 아이템 이름으로 실시간 조회(bw list items) + 파싱을 한 번에 수행
#                                  (세션 만료/미발견/중복(2개 이상) 시 에러 메시지 출력,
#                                   조용히 실패시키려면 2>/dev/null)
#                                  출력: username\temail\tpassword\tpat\tnotes (탭 구분)
#                                    - username: 아이템의 사용자 지정 필드 "user.name" 값이 있으면 그 값,
#                                                없으면 login.username(이메일)의 @ 앞부분
#                                    - email   : 아이템의 사용자 지정 필드 "user.email" 값이 있으면 그 값,
#                                                없으면 login.username(이메일) 그대로
#   bw_get_fields                → 아이템 이름 + 사용자 지정 필드 라벨 목록으로 값들을 한 번에 조회
#                                  사용법: bw_get_fields "<아이템명>" "필드1" "필드2" ...
#                                  → 탭 구분으로 요청 순서대로 반환 (없으면 빈 문자열)
#   bw_setup_git_config          → git 전역 설정 (user.name / user.email) — 없는 경우에만 대화형 설정
#                                  사용법: bw_setup_git_config <default_name> <default_email>
#   bw_save_git_credentials      → PAT 를 ~/.git-credentials 에 저장 (사용자 확인 후)
#                                  사용법: bw_save_git_credentials <repo_url> <pat> <username>
#   bw_git_credentials_exist     → ~/.git-credentials 에 해당 호스트(기본 github.com) 로그인이 있는지 확인
#   bw_gh_auth_ok                → GitHub CLI(gh) 로그인 여부 확인 (gh 미설치면 "해당 없음"으로 성공)
#   bw_setup_gh_auth             → PAT 로 GitHub CLI(gh) 로그인 (gh 미설치·이미 로그인이면 건너뜀)
#                                  사용법: bw_setup_gh_auth <pat> [host]
#   bw_setup_github_auth         → Bitwarden PAT 로 GitHub 로그인 일괄 설정 (설치 스크립트·프로젝트 설정 공용)
#                                  git user.name/email + ~/.git-credentials + gh CLI 로그인.
#                                  이미 로그인되어 있으면 Bitwarden 잠금 해제 없이 바로 끝냄.
#                                  Bitwarden 미로그인(unauthenticated)이면 그 자리에서 bw login 진행.
#                                  사용법: bw_setup_github_auth [bw_item_name]
#   bw_git_clone                 → Bitwarden PAT 인증으로 git clone 수행
#                                  (성공 시 bw_setup_git_config + bw_save_git_credentials + bw_setup_gh_auth 자동 호출)
#                                  사용법: bw_git_clone <repo_url> <target_dir> [bw_item_name]
#                                  bw_item_name 기본값: $BW_DEFAULT_PAT_ITEM (기본 "github.com-main")
#   bw_git_clone_interactive     → bw_git_clone 대화형 래퍼: Bitwarden 'GitHub' 항목 이름을 사용자에게
#                                  프롬프트로 입력받은 뒤 bw_git_clone 호출 (기본값 제안, 엔터 시 기본값 사용)
#                                  사용법: bw_git_clone_interactive <repo_url> <target_dir>
#                                  → 개별 프로젝트 설정 스크립트/command-palette 등에서 항목명을
#                                    직접 프롬프트하고 싶을 때 이 함수 하나만 호출하면 됩니다
#                                    (프롬프트 문구/로직을 바꿀 일이 생기면 여기 한 곳만 수정)
#   bw_git_clone_with_fallback   → 저장된 GitHub 로그인(~/.git-credentials)으로 먼저 clone 하고,
#                                  로그인이 없거나 인증에 실패하면 bw_git_clone_interactive 로 폴백
#                                  사용법: bw_git_clone_with_fallback <repo_url> <target_dir>
#   normalize_tty                → bind -x (Readline) 터미널 모드 정규화 (icanon icrnl echo 복원)
#
# 공통 상수:
#   BW_DEFAULT_PAT_ITEM          → PAT 인증에 사용할 Bitwarden 아이템 이름의 공통 기본값
#                                  ("github.com-main"). bw_git_clone / setup_gpr_gradle_properties
#                                  (common-setup.sh) 등 PAT 인증 관련 함수들이 공유해서 사용합니다.
#                                  다른 아이템을 쓰려면 함수 호출 시 인수로 이름을 넘기면 됩니다.
#                                  해당 이름과 정확히 일치하는 아이템이 없거나 2개 이상이면 에러 처리됩니다.
# ==============================================================================

# ── PAT 인증 관련 함수들이 공유하는 기본 Bitwarden 아이템 이름 ─────────────────
BW_DEFAULT_PAT_ITEM="${BW_DEFAULT_PAT_ITEM:-github.com-main}"

# ── OS 판별 (WSL / Linux) ───────────────────────────────────────────────────
# ⚠️ Windows 네이티브(Git Bash/MSYS/Cygwin)는 지원하지 않습니다. 이 도구들은 WSL 또는
#    리눅스에서만 실행합니다(Alt+c / Alt+h 도 WSL bash 의 readline 바인딩으로만 동작).
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    echo "❌ Windows 네이티브(Git Bash 등)는 지원하지 않습니다. WSL 터미널에서 실행해 주세요." >&2
    return 1 2>/dev/null || exit 1
fi
IS_WSL=false
if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
fi

# ── 공용 질문 함수 로드 (prompt_confirm · prompt_text · prompt_key · prompt_password) ──────────────
# 질문 색(노란색)과 기본값 색(초록색)을 설치 스크립트의 다른 질문과 같게 맞추기 위해, 직접 read -rp 로 묻지 않고
# _common.sh 의 공용 함수를 씁니다. 설치 스크립트에서는 이미 로드되어 있고, 명령 팔레트·bw-server-manager 처럼
# 단독으로 실행될 때만 DevTools2 저장소의 _common.sh 를 불러옵니다.
# (DT2_TMP 를 미리 정해 두어 _common.sh 가 실행할 때마다 /tmp 에 임시 폴더를 새로 만들지 않게 합니다)
if ! command -v prompt_confirm &>/dev/null; then
    _bw_common="${DEVTOOLS2:-/var/opt/_devtools2}/scripts/linux/dev-env/_common.sh"
    if [ -f "$_bw_common" ]; then
        if [ -z "${DT2_TMP:-}" ]; then
            DT2_TMP="${HOME:-/tmp}/.devtools2/tmp"
            (umask 077; mkdir -p "$DT2_TMP") 2>/dev/null || DT2_TMP=""
        fi
        # shellcheck disable=SC1090
        source "$_bw_common"
    fi
    unset _bw_common
fi

# ── 터미널 모드 정규화 헬퍼 ──────────────────────────────────────────────────
# bind -x (Readline 단축키) 환경에서 터미널을 canonical 모드로 복원합니다.
# Readline이 설정한 raw 모드(-icanon -icrnl)에서는 Enter(\r)가 Newline(\n)으로 변환되지 않아
# fzf 이후 실행되는 서브 스크립트나 비밀번호 입력(read, sudo)에서 엔터가 먹통이 되거나 인증에 실패합니다.
if ! command -v normalize_tty &>/dev/null; then
    normalize_tty() {
        if [ -c /dev/tty ]; then
            stty icanon icrnl echo < /dev/tty 2>/dev/null || true
        elif [ -t 0 ]; then
            stty icanon icrnl echo 2>/dev/null || true
        fi
    }
fi

# ── 클립보드 복사 및 보안 삭제 유틸리티 ──────────────────────────────────────
# 인자($1)가 있으면 인자를 복사하고, 없으면 표준 입력(stdin)을 클립보드로 복사합니다.
copy_to_clipboard() {
    local text
    if [ $# -gt 0 ]; then
        text="$1"
    else
        text=$(cat)
    fi

    if $IS_WSL; then
        if command -v clip.exe &>/dev/null; then
            printf "%s" "$text" | clip.exe
            return 0
        fi
    fi
    if command -v wl-copy &>/dev/null; then
        printf "%s" "$text" | wl-copy
        return 0
    elif command -v xclip &>/dev/null; then
        printf "%s" "$text" | xclip -selection clipboard
        return 0
    elif command -v xsel &>/dev/null; then
        printf "%s" "$text" | xsel --clipboard --input
        return 0
    fi
    return 1
}

# 클립보드를 즉시 비웁니다.
clear_clipboard() {
    copy_to_clipboard "" >/dev/null 2>&1 || true
}

# 백그라운드 타이머로 N초 후 클립보드를 비웁니다 (기본 30초).
clear_clipboard_delayed() {
    local sec="${1:-30}"
    ( sleep "$sec" && clear_clipboard ) >/dev/null 2>&1 &
}

# ── 호출자 trap 보존 헬퍼 ────────────────────────────────────────────────────
# bw-lib 은 다른 스크립트에 source 되므로, 임시 파일 정리용 trap 을 걸었다가 "trap -"로 지우면
# 호출한 스크립트가 걸어 둔 EXIT/INT/TERM trap(예: 임시 권한 회수)까지 사라집니다.
# 걸기 전에 기존 trap 을 저장(_bw_trap_save)하고, 끝나면 그대로 복원(_bw_trap_restore)합니다.
_bw_trap_save() {
    _BW_SAVED_TRAPS="$(trap -p EXIT INT TERM)"
}
_bw_trap_restore() {
    trap - EXIT INT TERM
    [ -n "${_BW_SAVED_TRAPS:-}" ] && eval "$_BW_SAVED_TRAPS"
    _BW_SAVED_TRAPS=""
}

# ── rclone 공용 헬퍼 (bw-server-manager, setup-projects/common-setup.sh 공용) ──────
# rclone.conf 경로: 사용자 홈(~/.config/rclone/rclone.conf, rclone 기본 위치)을 사용합니다.
# - 예전에는 공유 트리($DEVTOOLS2/modules/rclone/.config)에 두어, 여러 사용자가 쓰는 서버에서
#   한 파일을 같이 쓰거나(600 이면 다른 사용자는 읽지 못해 실패) 그룹원이 2770 디렉터리 안의
#   파일을 바꿔치기할 수 있었습니다. 비밀(난독화된 SFTP 비밀번호)은 각자 홈에 둡니다.
dt2_rclone_conf_path() {
    local _legacy="${DEVTOOLS2:-/var/opt/_devtools2}/modules/rclone/.config/rclone.conf"
    if [ -n "${RCLONE_CONFIG:-}" ] && [ "$RCLONE_CONFIG" != "$_legacy" ]; then
        echo "$RCLONE_CONFIG"
    else
        echo "$HOME/.config/rclone/rclone.conf"
    fi
}

# rclone 리모트의 pass 값을 설정 파일에 직접 기록합니다.
# 사용법: printf '%s' "$OBSCURED_PASS" | dt2_rclone_set_pass <리모트이름> <rclone.conf 경로>
# ⚠️ "rclone config create ... pass <값>" 처럼 인자로 넘기면 ps//proc 에 보이고,
#    rclone obscure 값은 "rclone reveal" 로 평문 복원이 가능하므로 사실상 평문 노출입니다.
#    그래서 값은 stdin 으로만 받아 파이썬이 파일(0600)에 씁니다.
dt2_rclone_set_pass() {
    python3 -c '
import configparser, os, sys
remote, path = sys.argv[1:3]
value = sys.stdin.read().strip()
c = configparser.ConfigParser(interpolation=None)
c.optionxform = str
c.read(path, encoding="utf-8")
if not c.has_section(remote):
    sys.stderr.write("rclone 리모트를 찾을 수 없습니다: %s\n" % remote)
    sys.exit(1)
c.set(remote, "pass", value)
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    c.write(f)
os.chmod(path, 0o600)
' "$1" "$2"
}

# ── 인메모리 비ASCII 문자 검사 함수 (프로세스 인자 노출 방지) ─────────────────
# C 로케일에서 [:print:] 는 0x20~0x7E 이므로, 그 밖의 바이트가 하나라도 있으면 참
has_non_ascii() ( LC_ALL=C; [[ "$1" == *[![:print:]]* ]] )

# ── 세션 파일 경로 결정 ────────────────────────────────────────────────────────
_BW_HOME_DIR="${HOME:-$USERPROFILE}"
_BW_DEVTOOLS2_DIR="${_BW_HOME_DIR}/.devtools2"
mkdir -p "$_BW_DEVTOOLS2_DIR"

if [ -d "/dev/shm" ]; then
    _BW_SESSION_FILE="/dev/shm/bw_session_${UID:-$(id -u)}"
else
    _BW_SESSION_FILE="${_BW_DEVTOOLS2_DIR}/bw_session"
fi

# ── bw vault 잠금 해제 수행 ───────────────────────────────────────────────────
_bw_do_unlock() {
    local _MASTER_PASS=""

    # bind -x (Readline 단축키: Alt+c / Alt+h) 환경 대응:
    # Readline이 설정한 raw 모드(-icanon -icrnl)에서는 Enter(\r)가 Newline(\n)으로 변환되지 않아
    # read 및 후속 프로세스(sudo 등)가 엔터 입력을 감지하지 못하거나 잘못된 문자(\r)로 인식합니다.
    # 터미널 모드를 canonical 모드로 정규화(icanon icrnl echo)합니다.
    # ⚠️ 주의: RETURN 시 raw 모드로 원복하면 후속 프로세스(git, sudo 등)의 입력이 망가지므로 원복하지 않습니다.
    normalize_tty

    # 마스터 비밀번호를 틀려도 바로 실패하지 않고 3번까지 다시 입력할 기회를 줍니다
    # (예전에는 한 번 틀리면 잠금 해제·GitHub 로그인 연결 전체가 실패로 끝났음)
    local _bw_try
    for _bw_try in 1 2 3; do
        # 공용 prompt_password 함수가 로드되어 있으면 사용, 없으면 자체 비영문 감지 입력 루프 실행
        if command -v prompt_password &>/dev/null; then
            prompt_password _MASTER_PASS "🔐 Bitwarden 마스터 비밀번호 입력 (보안 마스킹): 🔒"
        else
            while true; do
                echo ""
                read -rsp "🔐 Bitwarden 마스터 비밀번호 입력 (보안 마스킹): 🔒 " _MASTER_PASS </dev/tty
                echo ""

                if [ -z "$_MASTER_PASS" ]; then
                    echo "❌ 비밀번호가 입력되지 않았습니다."
                    return 1
                fi

                # 비영문/비ASCII 문자(한글, 일어, 중문, 전각문자 등: ASCII 32~126 범위를 벗어나는 모든 문자) 검사
                # ⚠️ 프로세스 인자 노출 방지를 위해 순수 bash 서브셸 인메모리 검사 수행
                if has_non_ascii "$_MASTER_PASS"; then
                    echo "❌ [오류] 입력된 마스터 비밀번호에 '비영문(한글/다국어/전각)' 문자가 포함되어 있습니다!"
                    echo "   키보드를 영문 입력 상태로 전환한 뒤 다시 입력해 주세요."
                    continue
                fi
                break
            done
        fi

        echo "🔓 Bitwarden vault 잠금 해제 중..."
        local _UNLOCK_OUTPUT
        # ⚠️ 비밀번호를 `bw unlock "$_MASTER_PASS"`처럼 커맨드라인 인자로 넘기면 실행되는
        # 짧은 순간 동안 ps/proc/cmdline을 통해 같은 시스템의 다른 사용자에게 노출될 수 있습니다.
        # Bitwarden 공식 문서가 권장하는 --passwordenv로 환경변수를 통해서만 전달합니다.
        export BW_PASSWORD="$_MASTER_PASS"
        unset _MASTER_PASS
        _UNLOCK_OUTPUT=$(bw unlock --passwordenv BW_PASSWORD 2>&1)
        unset BW_PASSWORD

        BW_SESSION=$(echo "$_UNLOCK_OUTPUT" | grep -oP '(?<=export BW_SESSION=")[^"]+' | head -1)
        [ -n "$BW_SESSION" ] && break
        if [ "$_bw_try" -lt 3 ]; then
            echo "❌ 마스터 비밀번호가 맞지 않습니다. 다시 입력해 주세요. (${_bw_try}/3)"
        fi
    done

    if [ -z "$BW_SESSION" ]; then
        echo "❌ 잠금 해제에 실패했습니다. 마스터 비밀번호를 확인해주세요."
        return 1
    fi

    (umask 077; echo "$BW_SESSION" > "$_BW_SESSION_FILE")
    chmod 600 "$_BW_SESSION_FILE" 2>/dev/null || true
    export BW_SESSION

    if [ -d "/dev/shm" ]; then
        echo "✅ 잠금 해제 완료. (세션키가 메모리(tmpfs)에 저장되었습니다)"
    else
        echo "✅ 잠금 해제 완료. (세션이 ${_BW_SESSION_FILE} 에 저장되었습니다)"
    fi
}

# ── BW_SESSION 보장 (핵심 진입점) ─────────────────────────────────────────────
# 호출 후 BW_SESSION 이 유효한 상태를 보장합니다.
# 반환: 0 = 성공, 1 = 실패
bw_ensure_session() {
    # bw CLI 존재 확인
    if ! command -v bw &>/dev/null; then
        echo "❌ Bitwarden CLI(bw)를 찾을 수 없습니다."
        echo "   설치 방법: https://bitwarden.com/help/cli/"
        return 1
    fi

    # 저장된 세션키 로드 (환경변수 우선, 없으면 파일)
    if [ -z "${BW_SESSION:-}" ] && [ -f "$_BW_SESSION_FILE" ]; then
        BW_SESSION=$(cat "$_BW_SESSION_FILE")
        export BW_SESSION
    fi

    # bw 상태 확인
    local _STATUS_JSON _STATUS
    _STATUS_JSON=$(bw status 2>/dev/null)
    _STATUS=$(echo "$_STATUS_JSON" | python3 -c "
import sys, json
try:
