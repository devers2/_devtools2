#!/usr/bin/env bash
# ==============================================================================
# [ALT+c] 독립형 명령어 팔레트 (OS 호환 및 Gradle 상태 동적 감지)
# ==============================================================================

# ── bw-lib 공유 라이브러리 로드 (Bitwarden 인증 모듈) ─────────────────────────
_CP_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_CP_SCRIPT_DIR/bw-lib" ]; then
    source "$_CP_SCRIPT_DIR/bw-lib"
elif [ -f "${DEVTOOLS2}/scripts/fzf/bw-lib" ]; then
    source "${DEVTOOLS2}/scripts/fzf/bw-lib"
fi
# bw-lib 없어도 다른 기능은 계속 동작하도록 에러 없이 진행

# ── bind -x (Readline 단축키) 환경 터미널 정규화 ─────────────────────────────
# Readline이 설정한 raw 모드(-icanon -icrnl)에서는 Enter(\r)가 개행(\n)으로 변환되지 않아
# fzf 이후 실행되는 서브 스크립트나 비밀번호 입력(read, sudo)에서 엔터가 먹통이 되거나 인증에 실패합니다.
if ! command -v normalize_tty &>/dev/null; then
    normalize_tty() {
        if [ -c /dev/tty ]; then
            stty icanon icrnl echo < /dev/tty 2>/dev/null || true
        elif [ -t 0 ]; then
            stty icanon icrnl echo 2>/dev/null || true
        fi
    }
fi

# ── bind -x 환경 tty 상태 백업 및 종료 시 원복 보장 ────────────────────────────
# bind -x로 실행된 스크립트 내부에서 normalize_tty로 canonical 모드로 전환하되,
# 스크립트 종료 시 Readline이 기대하는 원래 raw 모드(-icanon -echo)로 무조건 복원합니다.
# 이 처리가 없으면 2회차 이후 Alt+c/Alt+h 단축키가 먹통이 됩니다.
_ORIG_STTY=""
if [ -c /dev/tty ]; then
    _ORIG_STTY=$(stty -g < /dev/tty 2>/dev/null || true)
elif [ -t 0 ]; then
    _ORIG_STTY=$(stty -g 2>/dev/null || true)
fi
_restore_tty() {
    if [ -n "$_ORIG_STTY" ]; then
        if [ -c /dev/tty ]; then
            stty "$_ORIG_STTY" < /dev/tty 2>/dev/null || true
        elif [ -t 0 ]; then
            stty "$_ORIG_STTY" 2>/dev/null || true
        fi
    fi
}
# [Ctrl+C = 팔레트 전체 중단]
#   예전에는 INT 도 EXIT 와 같은 trap('_restore_tty' 만 실행)이라, Ctrl+C 로 Gradle 이 끊긴 뒤에도 스크립트가
#   다음 줄로 계속 진행했습니다(실측: Alt+C 로 실행한 Gradle 은 Ctrl+C 로 종료 코드 130 을 받고 끝나지만 팔레트는 계속 진행).
#   그래서 배포를 중단해도 "❌ 배포 실패 ... BUILD FAILED 원인을 확인" 같은 잘못된 안내가 나오고, 질문(read) 중 Ctrl+C 는
#   빈 답으로 다음 단계가 진행됐습니다. 이제 Ctrl+C 를 받으면 터미널을 원복하고 바로 종료합니다.
#   (Gradle 은 같은 Ctrl+C 를 함께 받아 클라이언트가 끝나고, 데몬은 진행 중인 작업을 취소합니다 — 실측 확인)
#   ● fzf 메뉴의 Ctrl+C 는 fzf 가 직접 처리(선택 취소)하므로 이 trap 과 무관합니다.
#   ● 스피너를 띄우려고 백그라운드(&)로 돌린 명령(예: Gradle 작업 목록 읽기)은 Ctrl+C 를 무시하므로
#     (비대화형 셸의 백그라운드 명령은 SIGINT 무시), 중단할 때 이 스크립트가 띄운 백그라운드 작업도 함께 종료합니다.
_cp_kill_bg_jobs() {
    local _p
    for _p in $(jobs -p 2>/dev/null); do
        pkill -TERM -P "$_p" 2>/dev/null || true   # ( ... ) & 서브셸 안의 실제 명령
        kill -TERM "$_p" 2>/dev/null || true
    done
}
trap '_restore_tty' EXIT
trap '_cp_kill_bg_jobs; _restore_tty; echo ""; echo "⛔ Ctrl+C 로 중단했습니다."; exit 130' INT
trap '_cp_kill_bg_jobs; _restore_tty; exit 143' TERM
normalize_tty

# 1. 현재 작업 환경 분석 및 OS 판별 (IS_WSL)
# ⚠️ WSL·리눅스 네이티브 전용입니다. Windows 네이티브(Git Bash 등)·macOS 는 지원하지 않습니다(AGENTS.md 7장).
CWD=$(pwd)
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    echo "❌ Windows 네이티브(Git Bash 등)는 지원하지 않습니다. WSL 터미널에서 실행해 주세요." >&2
    exit 1
fi
if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "❌ macOS 는 지원하지 않습니다(DevTools2 는 WSL·리눅스 전용)." >&2
    exit 1
fi
if [ -z "${IS_WSL+x}" ]; then
    IS_WSL=false
    if [[ "$OSTYPE" == linux-gnu* ]] && grep -qi microsoft /proc/version 2>/dev/null; then
        IS_WSL=true
    fi
fi

# 홈 디렉토리 판별 (Windows의 경우 USERPROFILE도 고려)
HOME_DIR="${HOME:-$USERPROFILE}"
if [[ -z "$HOME_DIR" ]]; then
    HOME_DIR="."
fi

# 사용자 부가 상태 저장 디렉토리 정의 (.devtools2 디렉토리 사용)
STATE_DIR="${HOME_DIR}/.devtools2"
STATE_FILE="${STATE_DIR}/state.properties"
mkdir -p "$STATE_DIR"

# 프로젝트별 유니크 키 생성 (CWD 끝의 슬래시를 정리한 후 md5sum 해시 추출)
NORM_CWD=$(echo "$CWD" | sed 's/\/$//')
PROJ_KEY=$(echo -n "$NORM_CWD" | md5sum | awk '{print $1}')

# ==============================================================================
# 2. 그룹 파일 불러오기 (palette.d/)
# ==============================================================================
# [설계 원칙 / Rationale]
#   ● 2,500줄 넘게 커진 팔레트를 1단계 메뉴 그룹마다 파일 하나로 나눴습니다(파일 이름 = 그룹 ID). 메뉴에서 보이는
#     구조와 파일 구조가 같아 항목을 더할 때 어느 파일을 고칠지 바로 알 수 있습니다.
#       gradle(🐘 Gradle) · git(🌿 Git · 프로젝트) · ai(🤖 AI) · tools(🧰 외부 도구) · system(🖥️ 시스템)
#       · runtime(☕ 런타임 · SDK) · convert(🔤 변환)
#   ● 두 그룹 이상이 쓰는 함수·값(포트·프로세스, 저장값, 클립보드, GUI 앱 실행, Git 저장소 위치, 메뉴 공용)은 _lib.sh,
#     한 그룹만 쓰는 것은 그 그룹 파일에 둡니다. 나중에 다른 그룹도 쓰게 되면 그때 _lib.sh 로 옮깁니다.
#   ● 그룹 파일은 메뉴 항목(_MENU_<그룹>), 1단계 등록(cp_register_group — 보일 조건 포함), 2단계 선택(cp_group_<그룹 ID>),
#     항목 실행 함수(cp_run_<항목 ID>)를 정의합니다. 아래 _CP_GROUP_FILES 순서가 1단계 메뉴 순서입니다.
#     순서 기준은 사용 빈도: 저장소 작업(Gradle·Git) → AI(이 팔레트에서만 하는 설정·Orca·스킬) → 외부 도구(다른 방법으로도 열 수 있음)
#     → 시스템 · 런타임 · 변환(가끔).
#   ● 실행 함수는 palette.d 파일 안에서 정의되므로 BASH_SOURCE[0] 이 그 파일을 가리킵니다. 팔레트 위치가 필요하면
#     $_CP_SCRIPT_DIR 을 씁니다(테스트 6-5 가 palette.d 의 BASH_SOURCE 사용을 막음).
#   ● 팔레트는 이 PC 의 저장소에서 실행되는 도구라(Alt+C → $DEVTOOLS2/scripts/fzf/command-palette) 옆 폴더의 파일을 읽습니다.
_CP_D="$_CP_SCRIPT_DIR/palette.d"
_CP_GROUP_FILES=(gradle git ai tools system runtime convert)
for _cp_f in _lib "${_CP_GROUP_FILES[@]}"; do
    if [ ! -f "$_CP_D/$_cp_f.sh" ]; then
        echo "❌ 명령 팔레트 파일이 없습니다: $_CP_D/$_cp_f.sh (DevTools2 저장소를 git pull 로 갱신해 주세요)" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$_CP_D/$_cp_f.sh"
done
unset _cp_f

# ==============================================================================
# 3. 그룹형 메뉴 (1단계: 그룹 → 2단계: 항목)
# ==============================================================================
# [설계 원칙 / Rationale]
#   ● 항목이 15개까지 한 줄로 늘어나 1단계를 그룹 7개로 정리했습니다. 그룹 문구에 하위 항목 키워드를 함께 적어
#     1단계에서 글자로 검색(예: "jdk", "포트")해도 해당 그룹이 바로 걸립니다.
#   ● Gradle 그룹(Gradle 프로젝트에서만 표시)은 빠른 실행(bootRun·빌드·배포)과 작업(Tasks) 트리를 한곳에 모았습니다(palette.d/gradle.sh 의 _gt_menu).
#   ● 항목은 "ID<TAB>표시 문구"이고 실행은 ID 로 고른 함수(cp_run_<ID>)가 합니다. 예전에는 메뉴 문구의 부분 문자열(*"실행"* 등)로
#     골라, 문구가 겹치면 엉뚱한 분기가 실행될 수 있었습니다(테스트 6-5 가 ID ↔ 실행 함수 짝을 검사).
#   ● 2단계에서 Esc 는 1단계로, 1단계에서 Esc 는 닫기.
#   ● 설치하지 않을 수도 있는 도구(VS Code·Zed·Orca·lazygit·gh)와 Git 저장소에서만 의미 있는 항목은 조건이 맞을 때만
#     보여 줍니다(Gradle 그룹과 같은 방식). 그룹 안 항목이 하나도 없으면 그룹 자체를 숨깁니다.
#     조건부 항목도 "ID<TAB>문구" 형식은 같아서 테스트 6-5 가 ID ↔ 실행 함수 짝을 그대로 검사합니다.

CHOICE_ID=""
while [ -z "$CHOICE_ID" ]; do
    _TOP=()
    for _g in "${_CP_GROUP_ORDER[@]}"; do
        _TOP+=("$_g	${_CP_GROUP_LABEL[$_g]}")
    done
    _TOP_SEL=$(printf '%s\n' "${_TOP[@]}" | fzf --delimiter=$'\t' --with-nth=2 --prompt="🚀 명령어 선택 (_devtools2) > " --height=40% --reverse) || true
    [ -z "$_TOP_SEL" ] && exit 0
    "cp_group_${_TOP_SEL%%$'\t'*}"
done

# ==============================================================================
# 4. 선택 항목별 실전 실행 프로세스 분기
# ==============================================================================
# 고른 항목 ID 의 실행 함수(cp_run_<ID> — 각 그룹 파일에 정의)를 부릅니다. 스크립트의 종료 코드는 그 함수의 종료 코드입니다.
if declare -F "cp_run_$CHOICE_ID" >/dev/null; then
    "cp_run_$CHOICE_ID"
else
    echo "❌ 알 수 없는 명령 항목입니다: $CHOICE_ID" >&2
    exit 1
fi
