#!/usr/bin/env bash
# ==============================================================================
# bw-server-manager: Bitwarden 기반 서버 접속 관리자 (Ghostty / fzf 전용)
# ==============================================================================
# 의존성: bw-lib (공유 인증 라이브러리), bw CLI, fzf, python3, ssh/sftp/rsync
# ==============================================================================

FOLDER_NAME="RemoteServer"

# ── bw-lib 공유 라이브러리 로드 ───────────────────────────────────────────────
_BW_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_BW_LIB_DIR/bw-lib" ]; then
    source "$_BW_LIB_DIR/bw-lib"
elif [ -f "$DEVTOOLS2/scripts/fzf/bw-lib" ]; then
    source "$DEVTOOLS2/scripts/fzf/bw-lib"
else
    echo "❌ bw-lib 파일을 찾을 수 없습니다. ($\_BW_LIB_DIR/bw-lib)"
    exit 1
fi

# ── OS 판별 ────────────────────────────────────────────────────────────────────
IS_WINDOWS=false
IS_MAC=false
IS_WSL=false
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    IS_WINDOWS=true
elif [[ "$OSTYPE" == "darwin"* ]]; then
    IS_MAC=true
elif grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
fi

# ── 클립보드 복사 (OS별) ───────────────────────────────────────────────────────
copy_to_clipboard() {
    local text="$1"
    if $IS_WINDOWS; then
        echo -n "$text" | clip.exe
    elif $IS_WSL; then
        echo -n "$text" | clip.exe
    elif $IS_MAC; then
        echo -n "$text" | pbcopy
    else
        if command -v wl-copy &>/dev/null; then
            echo -n "$text" | wl-copy
        elif command -v xclip &>/dev/null; then
            echo -n "$text" | xclip -selection clipboard
        elif command -v xsel &>/dev/null; then
            echo -n "$text" | xsel --clipboard --input
        else
            echo "⚠️  클립보드 도구(wl-copy/xclip/xsel)를 찾을 수 없습니다." >&2
        fi
    fi
}

# ──────────────────────────────────────────────────────────────────────────────
# STEP 1~3: Bitwarden 세션 확보 (bw-lib)
# ──────────────────────────────────────────────────────────────────────────────
echo "⏳ 서버 상태 확인하는 중..."
bw_ensure_session || exit 1

# ──────────────────────────────────────────────────────────────────────────────
# STEP 4: 'RemoteServer' 폴더 아이템 통합 조회 (bw-lib)
# ──────────────────────────────────────────────────────────────────────────────
echo "⏳ '${FOLDER_NAME}' 폴더 정보 조회 중..."
FOLDER_IDS=$(bw_get_folder_ids "$FOLDER_NAME")
if [ -z "$FOLDER_IDS" ]; then
    echo "❌ Bitwarden에서 '${FOLDER_NAME}' 폴더를 찾을 수 없습니다."
    echo "   Bitwarden 보관함에 '${FOLDER_NAME}' 폴더를 생성하고 서버 항목들을 이동시켜주세요."
    exit 1
fi

echo "⏳ 서버 목록 불러오는 중..."
RAW_ITEMS_LIST=$(bw_get_items_by_folder_name "$FOLDER_NAME") || exit 1

if [ -z "$RAW_ITEMS_LIST" ]; then
    echo "ℹ️  '${FOLDER_NAME}' 폴더에 항목이 없습니다."
    exit 0
fi

# ──────────────────────────────────────────────────────────────────────────────
# STEP 5: JSON 파싱 (복수 폴더 데이터 통합)
# 비밀번호는 목록에 절대 표시하지 않음
# 표시 형식: "서버이름 | 사용자명@호스트:포트  🔑(키있음)"
# 내부 형식: [표시]\t[itemID]\t[username]\t[uri]\t[has_key]
#
# ※ printf | python3 - <<HEREDOC 구조는 파이프(stdin)와 heredoc(stdin)이 충돌하여
#   데이터가 파이썬에 전달되지 않는 문제가 있으므로
#   파이썬 스크립트를 임시 파일로 분리 후 파이프로 데이터만 전달합니다.
# ──────────────────────────────────────────────────────────────────────────────
_PY_SCRIPT=$(mktemp /tmp/bw_parse_XXXXXX.py)
cat > "$_PY_SCRIPT" <<'PYEOF'
import sys, json, re

raw_all = sys.stdin.read()
chunks = raw_all.split('---ITEM_SPLIT---')

all_items = []
for chunk in chunks:
    chunk = chunk.strip()
    if not chunk:
        continue
    start_idx = chunk.find('[')
    end_idx = chunk.rfind(']')
    if start_idx != -1 and end_idx != -1 and start_idx < end_idx:
        try:
            items = json.loads(chunk[start_idx:end_idx+1], strict=False)
            if isinstance(items, list):
                all_items.extend(items)
        except Exception:
            pass

if not all_items:
    sys.exit(0)

for item in all_items:
    if not isinstance(item, dict):
        continue
    name     = item.get('name', '이름없음')
    item_id  = item.get('id', '')

    login = item.get('login')
    if not isinstance(login, dict):
        login = {}

    username = login.get('username') or ''
    uris     = login.get('uris') or []

    raw_uri = ''
    if isinstance(uris, list) and len(uris) > 0:
        first_uri = uris[0]
        if isinstance(first_uri, dict):
            raw_uri = first_uri.get('uri') or ''

    notes = item.get('notes') or ''
    if not isinstance(notes, str):
        notes = ''

    clean_uri = re.sub(r'^[a-z]+://', '', raw_uri)
    has_key = 'KEY' if re.search(r'BEGIN .* PRIVATE KEY', notes) else ''

    display = f"{name} | {username}@{clean_uri}"
    if has_key:
        display += " 🔑"

    print(f"{display}\t{item_id}\t{username}\t{clean_uri}\t{has_key}")
PYEOF

HOST_LIST=$(printf "%s" "$RAW_ITEMS_LIST" | python3 "$_PY_SCRIPT")
rm -f "$_PY_SCRIPT"

if [ -z "$HOST_LIST" ]; then
    echo "ℹ️  '${FOLDER_NAME}' 폴더에 등록된 서버 항목이 없습니다."
    exit 0
fi

# ──────────────────────────────────────────────────────────────────────────────
# STEP 6: fzf로 서버 선택
# ──────────────────────────────────────────────────────────────────────────────
CHOICE=$(
    echo "$HOST_LIST" | fzf \
        --prompt="🌐 접속할 서버 선택 > " \
        --height=50% \
        --reverse \
        --delimiter=$'\t' \
        --with-nth=1 \
        --header="[Enter] 선택  [ESC] 취소  │  비밀번호는 접속 선택 후 클립보드에 자동 저장됩니다"
)

if [ -z "$CHOICE" ]; then
    echo "🚪 취소되었습니다."
    exit 0
fi

# 탭 구분으로 내부 데이터 추출
ITEM_ID=$(echo "$CHOICE" | cut -f2)
USERNAME=$(echo "$CHOICE" | cut -f3)
RAW_URI=$(echo "$CHOICE" | cut -f4)
HAS_KEY=$(echo "$CHOICE" | cut -f5)
HOST_NAME=$(echo "$CHOICE" | cut -f1 | cut -d'|' -f1 | xargs)

# URI에서 호스트/포트 분리
if [[ "$RAW_URI" == *:* ]]; then
    ACTUAL_HOST="${RAW_URI%:*}"
    PORT="${RAW_URI##*:}"
else
    ACTUAL_HOST="$RAW_URI"
    PORT="22"
fi

# ──────────────────────────────────────────────────────────────────────────────
# STEP 7: 비밀번호를 itemID로 안전하게 조회 → 클립보드에만 저장
# (fzf 목록에 비밀번호 절대 노출 없음)
# ──────────────────────────────────────────────────────────────────────────────
SERVER_PASS=$(bw get password "$ITEM_ID" --session "$BW_SESSION" 2>/dev/null || echo "")

if [ -n "$SERVER_PASS" ]; then
    copy_to_clipboard "$SERVER_PASS"
    echo ""
    echo "📋 비밀번호를 클립보드에 저장했습니다."
    echo "   접속 후 비밀번호 프롬프트에 붙여넣기 하세요. (Ctrl+Shift+V 또는 마우스 우클릭)"
fi

# SSH 키 처리: notes에 private key가 있으면 임시 파일로 저장
SSH_KEY_OPT=""
if [ "$HAS_KEY" = "KEY" ]; then
    NOTES_CONTENT=$(bw get notes "$ITEM_ID" --session "$BW_SESSION" 2>/dev/null || echo "")
    if [ -n "$NOTES_CONTENT" ]; then
        KEY_DIR="${GHOSTTY_DIR}/keys"
        mkdir -p "$KEY_DIR"
        KEY_PATH="$KEY_DIR/bw_key_${ITEM_ID}"
        if [ ! -f "$KEY_PATH" ] || [ "$(cat "$KEY_PATH")" != "$NOTES_CONTENT" ]; then
            echo "$NOTES_CONTENT" >"$KEY_PATH"
            chmod 600 "$KEY_PATH"
        fi
        SSH_KEY_OPT="-i $KEY_PATH"
    fi
fi

# ──────────────────────────────────────────────────────────────────────────────
# STEP 8: 접속 방식 선택 (SSH / SFTP / Rsync / SFTP 마운트)
# ──────────────────────────────────────────────────────────────────────────────
echo ""
echo "🖥️  [$HOST_NAME]  →  $USERNAME@$ACTUAL_HOST:$PORT"
echo ""

ACTION_OPTIONS=("1. 원격 접속 (SSH)" "2. 파일 전송 (SFTP)")
if ! $IS_WINDOWS; then
    ACTION_OPTIONS+=("3. 파일 동기화 (Rsync)" "4. SFTP 마운트 (Rclone)")
fi

ACTION=$(
    printf "%s\n" "${ACTION_OPTIONS[@]}" | fzf \
        --prompt="🛠️  작업 선택 > " \
        --height=30% \
        --reverse \
        --header="[$HOST_NAME]  $USERNAME@$ACTUAL_HOST:$PORT"
)

if [ -z "$ACTION" ]; then
    echo "🚪 취소되었습니다."
    exit 0
fi

# ── SSH ───────────────────────────────────────────────────────────────────────
if [[ "$ACTION" == *"원격 접속"* ]]; then
    SSH_ARGS=(-p "$PORT")
    [ -n "$SSH_KEY_OPT" ] && SSH_ARGS+=($SSH_KEY_OPT)
    SSH_ARGS+=("$USERNAME@$ACTUAL_HOST")

    echo "🚀 SSH 접속: ssh ${SSH_ARGS[*]}"
    echo ""
    ssh "${SSH_ARGS[@]}"

# ── SFTP ──────────────────────────────────────────────────────────────────────
elif [[ "$ACTION" == *"파일 전송"* ]]; then
    # SFTP는 포트 옵션이 대문자 -P
    SFTP_ARGS=(-P "$PORT")
    [ -n "$SSH_KEY_OPT" ] && SFTP_ARGS+=($SSH_KEY_OPT)
    SFTP_ARGS+=("$USERNAME@$ACTUAL_HOST")

    echo "📁 SFTP 접속: sftp ${SFTP_ARGS[*]}"
    echo ""
    echo "  주요 명령어:"
    echo "  ls / lls      : 원격/로컬 파일 목록"
    echo "  cd / lcd      : 원격/로컬 디렉토리 이동"
    echo "  get [-r] 파일 : 다운로드 (-r: 디렉토리)"
    echo "  put [-r] 파일 : 업로드 (-r: 디렉토리)"
    echo "  exit          : 접속 종료"
    echo ""
    sftp "${SFTP_ARGS[@]}"

# ── Rsync ─────────────────────────────────────────────────────────────────────
elif [[ "$ACTION" == *"파일 동기화"* ]]; then
    RSYNC_SSH="ssh -p $PORT"
    [ -n "$SSH_KEY_OPT" ] && RSYNC_SSH="$RSYNC_SSH $SSH_KEY_OPT"

    echo ""
    echo "📦 Rsync 안내 [$HOST_NAME]"
    echo ""
    echo "  ✔ 로컬 → 원격 (업로드):"
    echo "    rsync -avzP -e \"$RSYNC_SSH\" [로컬경로] $USERNAME@$ACTUAL_HOST:[원격경로]"
    echo ""
    echo "  ✔ 원격 → 로컬 (다운로드):"
    echo "    rsync -avzP -e \"$RSYNC_SSH\" $USERNAME@$ACTUAL_HOST:[원격경로] [로컬경로]"
    echo ""
    echo "  ※ '-n' 옵션 추가 시 실제 전송 없이 미리보기 가능"
    echo ""

    read -rp "📂 방향 선택 (u=업로드 / d=다운로드): " DIRECTION
    if [[ "${DIRECTION,,}" == "u" ]]; then
        read -rp "📂 로컬 소스 경로: " L_SRC
        read -rp "📂 원격 대상 경로: " R_DEST
        read -rp "🔍 미리보기만? (y/N): " DRY
        DRY_OPT=""
        [[ "${DRY,,}" == "y" ]] && DRY_OPT="-n"
        echo ""
        echo "🚀 실행: rsync -avzP $DRY_OPT -e \"$RSYNC_SSH\" \"$L_SRC\" \"$USERNAME@$ACTUAL_HOST:$R_DEST\""
        # shellcheck disable=SC2086
        rsync -avzP $DRY_OPT -e "$RSYNC_SSH" "$L_SRC" "$USERNAME@$ACTUAL_HOST:$R_DEST"
    elif [[ "${DIRECTION,,}" == "d" ]]; then
        read -rp "📂 원격 소스 경로: " R_SRC
        read -rp "📂 로컬 대상 경로: " L_DEST
        read -rp "🔍 미리보기만? (y/N): " DRY
        DRY_OPT=""
        [[ "${DRY,,}" == "y" ]] && DRY_OPT="-n"
        echo ""
        echo "🚀 실행: rsync -avzP $DRY_OPT -e \"$RSYNC_SSH\" \"$USERNAME@$ACTUAL_HOST:$R_SRC\" \"$L_DEST\""
        # shellcheck disable=SC2086
        rsync -avzP $DRY_OPT -e "$RSYNC_SSH" "$USERNAME@$ACTUAL_HOST:$R_SRC" "$L_DEST"
    else
        echo "🚪 취소되었습니다."
    fi

# ── SFTP 마운트 (Rclone) ──────────────────────────────────────────────────────
elif [[ "$ACTION" == *"SFTP 마운트"* ]]; then
    SERVICE_NAME="rclone-${USERNAME}@${ACTUAL_HOST}_${PORT}"
    SERVICE_FILE="$HOME/.config/systemd/user/${SERVICE_NAME}.service"

    # 1. WSL 인 경우 systemd 활성화 여부 미리 확인
    if $IS_WSL; then
        if ! ps -p 1 -o comm= 2>/dev/null | grep -q systemd && ! systemctl is-system-running &>/dev/null; then
            echo "⚠️  WSL에서 systemd가 활성화되어 있지 않습니다."
            if ! grep -q "systemd=true" /etc/wsl.conf 2>/dev/null; then
                echo "⏳ /etc/wsl.conf 파일에 [boot] systemd=true 설정을 추가합니다..."
                if [ -w /etc/wsl.conf ]; then
                    printf "\n[boot]\nsystemd=true\n" >> /etc/wsl.conf
                else
                    sudo bash -c 'printf "\n[boot]\nsystemd=true\n" >> /etc/wsl.conf'
                fi
            fi
            echo ""
            echo "❌ systemd 활성화 설정 후 WSL 재부팅이 필요합니다."
            echo "   PowerShell에서 아래 명령어를 실행하여 WSL을 재부팅(종료 후 재시작)한 뒤 다시 진행해주세요:"
            echo ""
            echo "   👉  wsl --shutdown"
            echo ""
            exit 0
        fi
    fi

    # 2. 해당 서비스 유무 확인
    if [ -f "$SERVICE_FILE" ]; then
        # 서비스가 존재하는 경우 -> 상태 확인 및 토글/삭제 메뉴 제공
        while true; do
            echo ""
            echo "========================================================"
            echo "📦 Rclone 마운트 서비스 관리: $SERVICE_NAME"
            echo "========================================================"

            IS_ACTIVE=$(systemctl --user is-active "$SERVICE_NAME.service" 2>/dev/null || echo "inactive")
            IS_ENABLED=$(systemctl --user is-enabled "$SERVICE_NAME.service" 2>/dev/null || echo "disabled")

            echo "● 서비스 실행 상태 (active): $IS_ACTIVE"
            echo "● 부팅 시 자동 실행 (enabled): $IS_ENABLED"
            echo "--------------------------------------------------------"

            MGMT_OPTIONS=()
            if [ "$IS_ACTIVE" = "active" ]; then
                MGMT_OPTIONS+=("1. ⏹️  서비스 중지 (systemctl --user stop)")
            else
                MGMT_OPTIONS+=("1. ▶️  서비스 시작 (systemctl --user start)")
            fi

            if [ "$IS_ENABLED" = "enabled" ]; then
                MGMT_OPTIONS+=("2. 🛑  부팅 시 자동 실행 비활성화 (systemctl --user disable)")
            else
                MGMT_OPTIONS+=("2. 🔄  부팅 시 자동 실행 활성화 (systemctl --user enable)")
            fi

            MGMT_OPTIONS+=("3. 📊  상세 상태 확인 (systemctl --user status)")
            MGMT_OPTIONS+=("4. 🗑️  서비스 삭제 (서비스 및 설정 완전 제거)")
            MGMT_OPTIONS+=("5. 🚪  나가기")

            MGMT_CHOICE=$(
                printf "%s\n" "${MGMT_OPTIONS[@]}" | fzf \
                    --prompt="🛠️  서비스 작업 선택 > " \
                    --height=40% \
                    --reverse \
                    --header="[$SERVICE_NAME] 실행: $IS_ACTIVE | 자동실행: $IS_ENABLED"
            )

            if [ -z "$MGMT_CHOICE" ] || [[ "$MGMT_CHOICE" == *"나가기"* ]]; then
                echo "🚪 종료합니다."
                break
            elif [[ "$MGMT_CHOICE" == *"서비스 시작"* ]]; then
                echo "🚀 systemctl --user start ${SERVICE_NAME}.service 실행 중..."
                systemctl --user start "$SERVICE_NAME.service"
            elif [[ "$MGMT_CHOICE" == *"서비스 중지"* ]]; then
                echo "⏹️ systemctl --user stop ${SERVICE_NAME}.service 실행 중..."
                systemctl --user stop "$SERVICE_NAME.service"
            elif [[ "$MGMT_CHOICE" == *"자동 실행 활성화"* ]]; then
                echo "🔄 systemctl --user enable ${SERVICE_NAME}.service 실행 중..."
                systemctl --user enable "$SERVICE_NAME.service"
            elif [[ "$MGMT_CHOICE" == *"자동 실행 비활성화"* ]]; then
                echo "🛑 systemctl --user disable ${SERVICE_NAME}.service 실행 중..."
                systemctl --user disable "$SERVICE_NAME.service"
            elif [[ "$MGMT_CHOICE" == *"상세 상태"* ]]; then
                echo ""
                systemctl --user status "$SERVICE_NAME.service" --no-pager
                read -rp "엔터를 누르면 메뉴로 돌아갑니다..."
            elif [[ "$MGMT_CHOICE" == *"서비스 삭제"* ]]; then
                read -rp "⚠️ 정말로 서비스 ($SERVICE_NAME)를 삭제하시겠습니까? (y/N): " CONFIRM_DEL
                if [[ "${CONFIRM_DEL,,}" == "y" ]]; then
                    echo "🗑️ 서비스 중지 및 비활성화 중..."
                    systemctl --user stop "$SERVICE_NAME.service" 2>/dev/null
                    systemctl --user disable "$SERVICE_NAME.service" 2>/dev/null
                    rm -f "$SERVICE_FILE"
                    rclone config delete "$SERVICE_NAME" 2>/dev/null
                    systemctl --user daemon-reload
                    echo "✅ '$SERVICE_NAME' 서비스 및 Rclone 설정이 완전히 삭제되었습니다."
                    break
                else
                    echo "취소되었습니다."
                fi
            fi
        done

    else
        # 서비스가 없는 경우 -> 원격/로컬 경로 입력, Rclone 설정 및 systemd 서비스 생성/활성화
        echo ""
        echo "========================================================"
        echo "⚙️  새 Rclone 마운트 서비스 설정 ($SERVICE_NAME)"
        echo "========================================================"
        echo ""

        # 마운트할 원격 경로와 로컬 경로 입력 (기본값 ~/mount, ~ 확장 지원)
        read -rp "📂 마운트할 원격 경로 입력 [기본값: ~/mount]: " INPUT_REMOTE_PATH
        INPUT_REMOTE_PATH="${INPUT_REMOTE_PATH:-~/mount}"
        REMOTE_PATH="${INPUT_REMOTE_PATH/#\~/$HOME}"

        read -rp "📂 마운트할 로컬 경로 입력 [기본값: ~/mount]: " INPUT_LOCAL_PATH
        INPUT_LOCAL_PATH="${INPUT_LOCAL_PATH:-~/mount}"
        LOCAL_PATH="${INPUT_LOCAL_PATH/#\~/$HOME}"

        echo "📂 로컬 마운트 디렉터리 확인 및 생성 중: $LOCAL_PATH"
        mkdir -p "$LOCAL_PATH"

        RCLONE_BIN=$(command -v rclone 2>/dev/null || echo "/usr/bin/rclone")
        if [ ! -x "$RCLONE_BIN" ]; then
            echo "❌ Rclone 실행 파일을 찾을 수 없습니다. Rclone이 설치되어 있는지 확인해주세요."
            exit 1
        fi

        FUSERMOUNT_BIN=$(command -v fusermount 2>/dev/null || command -v fusermount3 2>/dev/null || echo "/usr/bin/fusermount")

        # 비트워든 정보 기반 Rclone SFTP 리모트 설정
        echo "⏳ Rclone SFTP 리모트 설정 중 ($SERVICE_NAME)..."
        RCLONE_ARGS=(config create "$SERVICE_NAME" sftp host "$ACTUAL_HOST" user "$USERNAME" port "$PORT")
        if [ -n "$SERVER_PASS" ]; then
            RCLONE_ARGS+=(pass "$SERVER_PASS")
        fi
        if [ "$HAS_KEY" = "KEY" ] && [ -n "$KEY_PATH" ] && [ -f "$KEY_PATH" ]; then
            RCLONE_ARGS+=(key_file "$KEY_PATH")
        fi

        RCLONE_ERR=$("${RCLONE_BIN}" "${RCLONE_ARGS[@]}" 2>&1)
        if [ $? -eq 0 ]; then
            echo "✅ Rclone 리모트 ($SERVICE_NAME) 설정 완료!"
        else
            echo "❌ Rclone 리모트 설정에 실패했습니다."
            echo "   오류 상세 내용: $RCLONE_ERR"
            exit 1
        fi

        RCLONE_CONF="$HOME/.config/rclone/rclone.conf"
        mkdir -p "$HOME/.config/systemd/user"

        # 서비스 파일 작성
        cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=rclone SFTP Mount for ${SERVICE_NAME}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${RCLONE_BIN} mount ${SERVICE_NAME}:${REMOTE_PATH} ${LOCAL_PATH} \\
    --vfs-cache-mode full \\
    --config=${RCLONE_CONF}
ExecStop=${FUSERMOUNT_BIN} -u ${LOCAL_PATH}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF

        echo "✅ 서비스 파일 작성 완료: $SERVICE_FILE"
        echo ""
        echo "⏳ systemd 서비스 활성화 및 시작 중..."
        systemctl --user daemon-reload
        systemctl --user enable "$SERVICE_NAME.service"
        systemctl --user start "$SERVICE_NAME.service"

        echo ""
        echo "🎉 '$SERVICE_NAME' 서비스가 정상적으로 생성 및 활성화되었습니다!"
        echo "--------------------------------------------------------"
        systemctl --user status "$SERVICE_NAME.service" --no-pager
    fi
fi

